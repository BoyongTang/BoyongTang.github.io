---
import { CENTRE, VIEW, relationStyle, topics } from '../data/atlas';
import { ambientStars, relationsOf, statusLabel, typeLabel, type Graph, type GraphNode } from '../lib/graph';

interface Props {
  graph: Graph;
  /** 'home' sits beside the profile; 'full' is the /atlas/ page with search and filters. */
  mode?: 'home' | 'full';
  heading?: string;
}

const { graph, mode = 'home', heading = 'Research sky / Atlas' } = Astro.props;
const uid = `atlas-${mode}`;
const stars = ambientStars(mode === 'full' ? 260 : 210);
const byId = new Map(graph.nodes.map((n) => [n.id, n]));

const rings = [96, 190, 300, 430];
const ticks = Array.from({ length: 72 }, (_, i) => i * 5);
const rad = (deg: number) => ((deg - 90) * Math.PI) / 180;

// label placement around a node
function labelPos(n: GraphNode) {
  const off = n.featured ? 34 : 17;
  switch (n.label) {
    case 'left':
      return { x: -off, y: 1, anchor: 'end', codeDy: 15 };
    case 'top':
      return { x: 0, y: -off - 2, anchor: 'middle', codeDy: -15 };
    case 'bottom':
      return { x: 0, y: off + 10, anchor: 'middle', codeDy: 15 };
    default:
      return { x: off, y: 1, anchor: 'start', codeDy: 15 };
  }
}

const grouped = topics
  .map((t) => ({ topic: t, items: graph.nodes.filter((n) => n.topic === t.id) }))
  .filter((g) => g.items.length);

const usedRelations = [...new Set(graph.edges.map((e) => e.relation))];
const usedTypes = [...new Set(graph.nodes.map((n) => n.type))];
---

<section class:list={['atlas', `atlas--${mode}`]} data-atlas data-mode={mode} aria-labelledby={`${uid}-title`}>
  <header class="atlas__bar">
    <h2 class="eyebrow" id={`${uid}-title`}>{heading}</h2>
    <div class="atlas__bar-right">
      {mode === 'home' && <a class="atlas__open" href="/atlas/">Full atlas ↗</a>}
      <div class="toggle" role="group" aria-label="View">
        <button type="button" data-view="map" aria-pressed="true">MAP</button>
        <button type="button" data-view="list" aria-pressed="false">LIST</button>
      </div>
    </div>
  </header>

  {
    mode === 'full' && (
      <div class="atlas__filters">
        <label class="atlas__search">
          <span class="visually-hidden">Search signals</span>
          <input type="search" placeholder="Search signals…" data-search autocomplete="off" />
        </label>
        <div class="atlas__chips" role="group" aria-label="Filter by research area">
          {topics.map((t) => (
            <button type="button" class="chip" data-topic={t.id} aria-pressed="false">
              {t.label}
            </button>
          ))}
        </div>
        <p class="atlas__count" aria-live="polite" data-count>
          {graph.nodes.length} signals
        </p>
      </div>
    )
  }

  <div class="atlas__map" data-map>
    <svg
      class="atlas__svg"
      viewBox={`0 0 ${VIEW.w} ${VIEW.h}`}
      preserveAspectRatio="xMidYMid meet"
      role="group"
      aria-label="Research atlas. Each labelled point is a question, method, project or note; lines are declared relations. The same content is available in the List view."
      data-svg
    >
      <defs>
        <radialGradient id={`${uid}-glow`}>
          <stop offset="0" stop-color="#e9c18f" stop-opacity="0.55"></stop>
          <stop offset="0.45" stop-color="#e9c18f" stop-opacity="0.12"></stop>
          <stop offset="1" stop-color="#e9c18f" stop-opacity="0"></stop>
        </radialGradient>
        <radialGradient id={`${uid}-nebula`} cx="0.5" cy="0.5" r="0.5">
          <stop offset="0" stop-color="#1f4a63" stop-opacity="0.55"></stop>
          <stop offset="1" stop-color="#0b1d30" stop-opacity="0"></stop>
        </radialGradient>
      </defs>

      <g data-viewport>
        <rect class="atlas__bg" x="-2000" y="-2000" width="5000" height="5000" fill="transparent" data-bg></rect>

        <!-- 01 / atmosphere: decorative only -->
        <g class="layer-atmosphere" aria-hidden="true">
          <ellipse cx={CENTRE.x} cy={CENTRE.y} rx="430" ry="330" fill={`url(#${uid}-nebula)`}></ellipse>
          {
            stars.map((s) => (
              <circle cx={s.x} cy={s.y} r={s.r} opacity={s.o} class:list={['star', s.twinkle && `tw tw${s.twinkle}`]} />
            ))
          }
        </g>

        <!-- 03 / context: instrument geometry, a metaphor and not a coordinate system -->
        <g class="layer-instrument" aria-hidden="true">
          {rings.map((r, i) => <circle cx={CENTRE.x} cy={CENTRE.y} r={r} class:list={['ring', i === 2 && 'ring--scale']} />)}
          <line x1={CENTRE.x - 470} y1={CENTRE.y} x2={CENTRE.x + 470} y2={CENTRE.y} class="axis" />
          <line x1={CENTRE.x} y1={CENTRE.y - 380} x2={CENTRE.x} y2={CENTRE.y + 380} class="axis" />
          {
            ticks.map((d) => {
              const long = d % 30 === 0;
              const r0 = 300;
              const r1 = long ? 312 : 305;
              return (
                <line
                  x1={CENTRE.x + r0 * Math.cos(rad(d))}
                  y1={CENTRE.y + r0 * Math.sin(rad(d))}
                  x2={CENTRE.x + r1 * Math.cos(rad(d))}
                  y2={CENTRE.y + r1 * Math.sin(rad(d))}
                  class:list={['tick', long && 'tick--long']}
                />
              );
            })
          }
          {
            [0, 90, 180, 270].map((d) => (
              <text
                x={CENTRE.x + 326 * Math.cos(rad(d))}
                y={CENTRE.y + 326 * Math.sin(rad(d)) + 4}
                text-anchor="middle"
                class="deg"
              >
                {String(d).padStart(3, '0')}
              </text>
            ))
          }
        </g>

        <!-- topic labels -->
        <g class="layer-topics" aria-hidden="true">
          {
            topics.map((t) => (
              <text x={t.x} y={t.y} text-anchor="middle" class="topic" data-topic-label={t.id}>
                {t.label.toUpperCase()}
              </text>
            ))
          }
        </g>

        <!-- 02 / meaning: declared relations -->
        <g class="layer-edges">
          {
            graph.edges.map((e) => {
              const a = byId.get(e.source)!;
              const b = byId.get(e.target)!;
              return (
                <line
                  x1={a.x}
                  y1={a.y}
                  x2={b.x}
                  y2={b.y}
                  class={`edge edge--${e.relation}`}
                  stroke-dasharray={e.dash || undefined}
                  data-s={e.source}
                  data-t={e.target}
                />
              );
            })
          }
        </g>
        <g class="layer-edge-labels" aria-hidden="true">
          {
            graph.edges.map((e) => {
              const a = byId.get(e.source)!;
              const b = byId.get(e.target)!;
              return (
                <text x={(a.x + b.x) / 2} y={(a.y + b.y) / 2 - 6} text-anchor="middle" class="edge-label" data-s={e.source} data-t={e.target}>
                  {e.relationLabel}
                </text>
              );
            })
          }
        </g>

        <!-- 02 / meaning: real, readable things -->
        <g class="layer-nodes">
          {
            graph.nodes.map((n) => {
              const l = labelPos(n);
              return (
                <a
                  href={n.url}
                  class:list={['node', `node--${n.type}`, n.featured && 'node--featured']}
                  data-id={n.id}
                  data-topic={n.topic}
                  transform={`translate(${n.x} ${n.y})`}
                  aria-label={`${typeLabel[n.type]} ${n.code}: ${n.title}. ${statusLabel(n.status)}.`}
                  {...(n.external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  <circle class="node__hit" r="22" />
                  {n.featured && (
                    <g class="node__beacon" aria-hidden="true">
                      <circle r="46" fill={`url(#${uid}-glow)`} class="node__glow" />
                      <circle r="18" class="node__orbit" />
                      <circle r="27" class="node__orbit node__orbit--outer" />
                    </g>
                  )}
                  <circle class="node__halo" r={n.type === 'research' ? 15 : 12} />
                  {n.type === 'research' && (
                    <>
                      <circle class="node__ring" r="9.5" />
                      <circle class="node__core" r="5" />
                    </>
                  )}
                  {n.type === 'question' && <circle class="node__core node__core--hollow" r="6" />}
                  {n.type === 'method' && <rect class="node__core" x="-5.2" y="-5.2" width="10.4" height="10.4" transform="rotate(45)" />}
                  {n.type === 'note' && <rect class="node__core node__core--note" x="-4.5" y="-4.5" width="9" height="9" />}
                  {n.type === 'tool' && <path class="node__core" d="M0 -7 L6.5 5 L-6.5 5 Z" />}
                  {n.type === 'paper' && <path class="node__core" d="M0 -7 L2 -2 L7 -2 L3 1.5 L4.5 7 L0 4 L-4.5 7 L-3 1.5 L-7 -2 L-2 -2 Z" />}
                  <text class="node__label" x={l.x} y={l.y} text-anchor={l.anchor}>
                    {n.short}
                  </text>
                  <text class="node__code" x={l.x} y={l.y + l.codeDy} text-anchor={l.anchor}>
                    {n.code}
                  </text>
                </a>
              );
            })
          }
        </g>
      </g>
    </svg>

    <div class="atlas__tools" role="group" aria-label="Map controls">
      <button type="button" class="icon-btn" data-zoom="in" aria-label="Zoom in">+</button>
      <button type="button" class="icon-btn" data-zoom="out" aria-label="Zoom out">−</button>
      <button type="button" class="icon-btn" data-zoom="reset" aria-label="Reset view">⟲</button>
    </div>

    <div class="atlas__legend" aria-hidden="true">
      <ul class="legend-types">
        {
          usedTypes.map((t) => (
            <li>
              <svg viewBox="-9 -9 18 18" width="14" height="14" class={`legend-glyph node--${t}`}>
                {t === 'research' && <circle class="node__core" r="5" />}
                {t === 'question' && <circle class="node__core node__core--hollow" r="5" />}
                {t === 'method' && <rect class="node__core" x="-4.5" y="-4.5" width="9" height="9" transform="rotate(45)" />}
                {t === 'note' && <rect class="node__core node__core--note" x="-4" y="-4" width="8" height="8" />}
                {t === 'tool' && <path class="node__core" d="M0 -6 L5.5 4.5 L-5.5 4.5 Z" />}
                {t === 'paper' && <path class="node__core" d="M0 -6 L1.8 -1.8 L6 -1.8 L2.6 1.3 L3.8 6 L0 3.4 L-3.8 6 L-2.6 1.3 L-6 -1.8 L-1.8 -1.8 Z" />}
              </svg>
              {typeLabel[t]}
            </li>
          ))
        }
      </ul>
      <ul class="legend-relations">
        {
          usedRelations.map((r) => (
            <li>
              <svg viewBox="0 0 28 6" width="28" height="6">
                <line x1="0" y1="3" x2="28" y2="3" stroke-dasharray={relationStyle[r].dash || undefined} />
              </svg>
              {relationStyle[r].label}
            </li>
          ))
        }
      </ul>
    </div>

    <aside class="atlas__preview" data-preview hidden aria-live="polite" tabindex="-1">
      <button type="button" class="atlas__close" data-close aria-label="Clear selection">×</button>
      <p class="eyebrow">Selected / <span class="code" data-p-code></span></p>
      <h3 data-p-title></h3>
      <p class="atlas__p-meta"><span data-p-type></span> · <span class="status" data-p-status></span> <span class="sample-tag" data-p-sample hidden>SAMPLE</span></p>
      <p class="atlas__p-summary" data-p-summary></p>
      <p class="eyebrow atlas__p-rel-head">Related signals / <span data-p-count></span></p>
      <ul class="atlas__p-rel" data-p-rel></ul>
      <a class="btn btn--primary atlas__p-open" data-p-open href="#">Open dossier →</a>
    </aside>
  </div>

  <div class="atlas__list" data-list hidden>
    {
      grouped.map((g) => (
        <section class="atlas__group" data-group={g.topic.id}>
          <h3 class="kicker">{g.topic.label}</h3>
          <ul>
            {g.items.map((n) => (
              <li data-item={n.id} data-topic={n.topic} data-text={`${n.code} ${n.title} ${n.summary} ${n.topicLabel} ${typeLabel[n.type]}`.toLowerCase()}>
                <span class="code">{n.code}</span>
                <div>
                  <a href={n.url} {...(n.external ? { target: '_blank', rel: 'noopener' } : {})}>
                    {n.title}
                    {n.external && ' ↗'}
                  </a>
                  <span class="atlas__li-meta">
                    {typeLabel[n.type]} · <span class={`status status--${n.status}`}>{statusLabel(n.status)}</span>
                    {n.sample && <span class="sample-tag">SAMPLE</span>}
                  </span>
                  <p>{n.summary}</p>
                  {relationsOf(graph, n.id).length > 0 && (
                    <ul class="atlas__li-rel">
                      {relationsOf(graph, n.id).map((r) => (
                        <li>
                          {r.outgoing ? (
                            <>
                              <em>{r.edge.relationLabel}</em> → {r.other.code} {r.other.short}
                            </>
                          ) : (
                            <>
                              {r.other.code} {r.other.short} → <em>{r.edge.relationLabel}</em> this
                            </>
                          )}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    <p class="atlas__empty" data-empty hidden>No matching signals. <button type="button" class="btn btn--ghost" data-clear>Clear filters</button></p>
  </div>

  <p class="atlas__note">Conceptual layout — positions are not coordinates, sizes are not rankings.</p>

  <script type="application/json" data-atlas-data set:html={JSON.stringify(graph)} />
</section>

<script>
  import { initAtlas } from '../scripts/atlas';
  document.querySelectorAll<HTMLElement>('[data-atlas]').forEach((el) => initAtlas(el));
</script>

<style is:global>
  .atlas {
    --k: 1.2;
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .atlas__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 0 14px;
  }

  .atlas__bar h2 {
    font-size: 12px;
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .atlas__bar-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .atlas__open {
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .atlas__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    padding-bottom: 16px;
  }

  .atlas__search input {
    width: min(320px, 80vw);
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    background: rgb(7 19 32 / 0.8);
    color: var(--starlight);
    font: 400 14px var(--font-mono);
  }

  .atlas__search input::placeholder {
    color: var(--dim);
  }

  .atlas__search input:focus-visible {
    border-color: var(--signal-cyan);
  }

  .atlas__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .atlas__count {
    margin: 0 0 0 auto;
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.12em;
    color: var(--dim);
  }

  .atlas__map {
    position: relative;
    flex: 1;
    min-height: 0;
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius-md);
    background:
      linear-gradient(rgb(56 84 103 / 0.07) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(90deg, rgb(56 84 103 / 0.07) 1px, transparent 1px) 0 0 / 40px 40px,
      radial-gradient(ellipse at 55% 50%, rgb(22 48 68 / 0.9), rgb(7 19 32 / 0.6) 75%);
    overflow: hidden;
  }

  .atlas__svg {
    width: 100%;
    height: 100%;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  .atlas--full .atlas__svg {
    touch-action: none;
  }

  .atlas__svg.is-dragging {
    cursor: grabbing;
  }

  .atlas__bg {
    cursor: grab;
  }

  /* atmosphere */
  .star {
    fill: #dfeef0;
  }

  .tw {
    animation: twinkle 6s ease-in-out infinite;
  }

  .tw2 { animation-duration: 8s; animation-delay: -3s; }
  .tw3 { animation-duration: 11s; animation-delay: -5s; }
  .tw4 { animation-duration: 14s; animation-delay: -7s; }

  @keyframes twinkle {
    0%, 100% { opacity: 0.2; }
    50% { opacity: 0.85; }
  }

  /* instrument */
  .ring {
    fill: none;
    stroke: #385467;
    stroke-opacity: 0.45;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .ring--scale {
    stroke-dasharray: 2 6;
    stroke-opacity: 0.7;
  }

  .axis {
    stroke: #385467;
    stroke-opacity: 0.28;
    stroke-dasharray: 1 7;
    vector-effect: non-scaling-stroke;
  }

  .tick {
    stroke: #385467;
    stroke-opacity: 0.7;
    vector-effect: non-scaling-stroke;
  }

  .tick--long {
    stroke: #6f8ea0;
  }

  .deg {
    font: 500 calc(10px * var(--k)) var(--font-mono);
    letter-spacing: 0.1em;
    fill: #6f8ea0;
  }

  .topic {
    font: 500 calc(11px * var(--k)) var(--font-mono);
    letter-spacing: 0.24em;
    fill: #8fa9b3;
    transition: fill var(--t-focus) var(--ease), opacity var(--t-focus) var(--ease);
  }

  /* edges */
  .edge {
    stroke: #8fc3b4;
    stroke-opacity: 0.32;
    stroke-width: 1.1;
    vector-effect: non-scaling-stroke;
    transition: stroke-opacity var(--t-focus) var(--ease), stroke var(--t-focus) var(--ease);
  }

  .edge-label {
    font: 500 calc(10.5px * var(--k)) var(--font-mono);
    letter-spacing: 0.1em;
    fill: #8fc3b4;
    paint-order: stroke;
    stroke: #071320;
    stroke-width: calc(4px * var(--k));
    opacity: 0;
    transition: opacity var(--t-focus) var(--ease);
    pointer-events: none;
  }

  /* nodes */
  .node {
    cursor: pointer;
    outline: none;
  }

  .node__hit {
    fill: transparent;
  }

  .node__halo {
    fill: none;
    stroke: #82d0dc;
    stroke-width: 1.2;
    opacity: 0;
    vector-effect: non-scaling-stroke;
    transition: opacity var(--t-identify) var(--ease);
  }

  .node__core {
    fill: #ecf3f0;
    stroke: #ecf3f0;
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
    transition: fill var(--t-identify) var(--ease), stroke var(--t-identify) var(--ease);
  }

  .node__core--hollow {
    fill: #0b1d30;
    stroke: #82d0dc;
    stroke-width: 1.6;
  }

  .node--method .node__core {
    fill: #0b1d30;
    stroke: #8fc3b4;
    stroke-width: 1.5;
  }

  .node__core--note {
    fill: #b9cfd6;
    stroke: #b9cfd6;
  }

  .node--tool .node__core {
    fill: none;
    stroke: #b9cfd6;
    stroke-width: 1.5;
  }

  .node__ring {
    fill: none;
    stroke: #82d0dc;
    stroke-opacity: 0.8;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .node--featured .node__core {
    fill: #e9c18f;
    stroke: #e9c18f;
  }

  .node--featured .node__ring {
    stroke: #e9c18f;
  }

  .node__orbit {
    fill: none;
    stroke: #e9c18f;
    stroke-opacity: 0.55;
    vector-effect: non-scaling-stroke;
  }

  .node__orbit--outer {
    stroke-opacity: 0.25;
    stroke-dasharray: 2 4;
    transform-origin: 0 0;
    animation: orbit 60s linear infinite;
  }

  .node__glow {
    animation: breathe 7s ease-in-out infinite;
  }

  @keyframes orbit {
    to { transform: rotate(360deg); }
  }

  @keyframes breathe {
    0%, 100% { opacity: 0.75; }
    50% { opacity: 1; }
  }

  .node__label {
    font: 500 calc(12.5px * var(--k)) var(--font-display);
    fill: #ecf3f0;
    paint-order: stroke;
    stroke: #0b1d30;
    stroke-width: calc(4px * var(--k));
    stroke-linejoin: round;
    transition: fill var(--t-identify) var(--ease), opacity var(--t-focus) var(--ease);
  }

  .node--featured .node__label {
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .node__code {
    font: 500 calc(9.5px * var(--k)) var(--font-mono);
    letter-spacing: 0.14em;
    fill: #8fa9b3;
    paint-order: stroke;
    stroke: #0b1d30;
    stroke-width: calc(3px * var(--k));
    transition: opacity var(--t-focus) var(--ease);
  }

  .node:hover .node__halo,
  .node:focus-visible .node__halo,
  .node.is-hot .node__halo {
    opacity: 0.9;
  }

  .node:focus-visible .node__halo {
    stroke: #e9c18f;
    stroke-width: 2.5;
    opacity: 1;
  }

  .node:hover .node__label,
  .node:focus-visible .node__label {
    fill: #82d0dc;
  }

  .node.is-selected .node__core {
    fill: #e9c18f;
    stroke: #e9c18f;
  }

  .node.is-selected .node__halo {
    stroke: #e9c18f;
    opacity: 1;
  }

  .node.is-selected .node__label {
    fill: #e9c18f;
  }

  /* focus mode: dim everything that is not related */
  .atlas__svg.has-focus .node:not(.is-hot) .node__core,
  .atlas__svg.has-focus .node:not(.is-hot) .node__ring {
    opacity: 0.35;
  }

  .atlas__svg.has-focus .node:not(.is-hot) .node__label,
  .atlas__svg.has-focus .node:not(.is-hot) .node__code {
    opacity: 0.35;
  }

  .atlas__svg.has-focus .edge {
    stroke-opacity: 0.1;
  }

  .atlas__svg.has-focus .edge.is-hot {
    stroke: #82d0dc;

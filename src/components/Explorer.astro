---
// The Pillars of Creation as the interface: one still view of the whole pillars, with no zooming or
// dragging. The four parts of me sit on places where stars are born; choosing one unfolds its stars right
// there, a star opens its card, and a click anywhere else steps back. The living sky behind it is drawn by
// Backdrop.astro; this component holds everything you can touch.
// Without JavaScript the parts are plain links to their pages and every star is in the lists below.
import { facets, type FacetId } from '../data/facets';
import { creditLine, labelLeft, PILLARS, spots } from '../data/pillars';
import { profile } from '../data/profile';
import { fitPillars, objectPosition } from '../lib/pillars-fit';
import type { SkyFacet } from '../lib/sky';

interface Props {
  sky: SkyFacet[];
  /** Open on this part (its own page); otherwise the whole pillars, with the name (home). */
  focus?: FacetId;
}

const { sky, focus } = Astro.props;
const home = !focus;
const W = PILLARS.size.w;
const H = PILLARS.size.h;

// each part's constellation, laid out round its spot in image pixels (wide and tall screens)
// a constellation spans about half the image's width on wide screens, a little less on tall ones
const R = { wide: W * 0.6, tall: W * 0.72 };
const parts = sky.map((f) => {
  const [sx, sy] = spots[f.id];
  const lay = (shape: 'wide' | 'tall') => {
    const v = shape === 'wide' ? f.view : f.tallView;
    const k = R[shape] / v.w;
    const half = (v.w * k) / 2;
    const cx = Math.min(W - half - 40, Math.max(half + 40, sx * W));
    const cy = sy * H;
    const vx = v.x + v.w / 2;
    const vy = v.y + v.h / 2;
    const pts = f.items.map((s) => {
      const p = shape === 'wide' ? s : s.tall;
      return { id: s.id, x: +(cx + (p.x - vx) * k).toFixed(1), y: +(cy + (p.y - vy) * k).toFixed(1), side: p.side };
    });
    return { cx, cy, w: v.w * k, h: v.h * k, vw: v.w, vh: v.h, pts };
  };
  return { f, wide: lay('wide'), tall: lay('tall') };
});

// the layout without JavaScript: the parts where they sit on a typical wide and tall screen
const REF = { wide: { w: 1440, h: 830 }, tall: { w: 390, h: 720 } };
const fw = fitPillars(REF.wide.w, REF.wide.h);
const ft = fitPillars(REF.tall.w, REF.tall.h);
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
---

<script is:inline>
  // The opening plays once per visit on the home page, never with reduced motion; ?intro plays it again.
  (function () {
    var root = document.currentScript && document.currentScript.nextElementSibling;
    if (!root || root.dataset.home !== '1') return;
    var html = document.documentElement;
    var force = /[?&]intro\b/.test(location.search);
    var reduce = html.dataset.motion === 'reduce' || matchMedia('(prefers-reduced-motion: reduce)').matches;
    var seen = false;
    try { seen = sessionStorage.getItem('oq.pillars') === '1'; } catch (e) {}
    if (reduce || (seen && !force)) return;
    html.classList.add('sky-intro');
    setTimeout(function () { if (!html.dataset.sky) html.classList.remove('sky-intro'); }, 4500);
  })();
</script>

<section
  class:list={['ex', home && 'ex--home']}
  aria-label="The Pillars of Creation, with the four parts of me. Choose a part to open it."
  data-ex
  data-home={home ? '1' : '0'}
  data-focus={focus ?? ''}
  data-parts={JSON.stringify(parts.map((p) => ({ id: p.f.id, spot: spots[p.f.id], wide: p.wide, tall: p.tall })))}
>
  <!-- the still image: what shows without WebGL (the living sky is drawn behind the page instead) -->
  <img
    class="ex__still"
    src={PILLARS.variants.tall.src}
    alt="The Pillars of Creation: three columns of rust-brown dust rising into a black, starry sky, edged with teal light."
    loading="lazy"
    decoding="async"
    style={`--pw:${objectPosition(fw, REF.wide.w, REF.wide.h)};--pt:${objectPosition(ft, REF.tall.w, REF.tall.h)}`}
    data-still
  />
  <div class="ex__veil" aria-hidden="true"></div>

  <svg class="ex__stars" aria-hidden="false" role="group" aria-label="Stars of the open part" data-layer>
    <defs>
      {
        facets.map((f) => (
          <radialGradient id={`xg-${f.id}`}>
            <stop offset="0" stop-color="#ffffff" stop-opacity="0.95" />
            <stop offset="0.14" stop-color={f.color} stop-opacity="0.75" />
            <stop offset="0.4" stop-color={f.color} stop-opacity="0.2" />
            <stop offset="1" stop-color={f.color} stop-opacity="0" />
          </radialGradient>
        ))
      }
    </defs>
    {
      parts.map(({ f, wide, tall }) => (
        <g class="xpart" data-xpart={f.id} style={`--c:${f.color}`}>
          {f.lines.map(([a, b]) => (
            <line class="xline" data-a={a.id} data-b={b.id} />
          ))}
          {f.items.map((s, i) => {
            const w = wide.pts[i];
            const t = tall.pts[i];
            const big = s.mag === 1;
            return (
              <a
                class:list={['xstar', big && 'xstar--bright']}
                href={`#i-${s.id}`}
                data-star={s.id}
                data-w={`${w.x} ${w.y} ${w.side}`}
                data-t={`${t.x} ${t.y} ${t.side}`}
                tabindex="-1"
                aria-label={`${s.kind}: ${s.name}${s.sub ? `, ${s.sub}` : ''}`}
                style={`--i:${i}`}
              >
                <circle class="xstar__hit" r="22" />
                <circle class="xstar__glow" r={big ? 26 : 19} fill={`url(#xg-${f.id})`} />
                <circle class="xstar__ring" r={big ? 9 : 7} />
                <circle class="xstar__core" r={big ? 2.8 : 2.2} />
                <text class="xstar__name" dy="-0.15em" lang={s.lang}>
                  {s.name}
                </text>
                <text class="xstar__sub" dy="1.5em">
                  {s.kind.toUpperCase()}
                  {s.sub ? ` · ${s.sub}` : ''}
                </text>
              </a>
            );
          })}
        </g>
      ))
    }
  </svg>

  <nav class="ex__parts" aria-label="Four parts of me">
    {
      parts.map(({ f }, i) => {
        const [x, y] = spots[f.id];
        const [wx, wy] = fw.at(x, y);
        const [tx, ty] = ft.at(x, y);
        return (
          <a
            class:list={['part', labelLeft[f.id].wide && 'part--flip-wide', labelLeft[f.id].tall && 'part--flip-tall']}
            href={`/sky/${f.id}/`}
            id={`n-${f.id}`}
            data-part={f.id}
            style={`--wx:${pct(wx, REF.wide.w)};--wy:${pct(wy, REF.wide.h)};--tx:${pct(tx, REF.tall.w)};--ty:${pct(ty, REF.tall.h)};--c:${f.color};--i:${i}`}
            aria-label={`${f.name}, ${f.nameZh}: ${f.line}`}
          >
            <span class="part__halo" aria-hidden="true" />
            <span class="part__ring" aria-hidden="true" />
            <span class="part__core" aria-hidden="true" />
            <span class="part__label" aria-hidden="true">
              <span class="part__name">{f.name}</span>
              <span class="part__zh" lang="zh">
                {f.nameZh}
              </span>
            </span>
          </a>
        );
      })
    }
  </nav>

  <!-- the caption, bottom centre: the name, or the open part -->
  <div class="ex__caption" aria-live="polite">
    {
      home && (
        <div class="ex__cap ex__cap--home">
          <h1 class="ex__name">{profile.name}</h1>
          <p class="ex__tag">{profile.tagline}</p>
        </div>
      )
    }
    {
      sky.map((f) => (
        <div class="ex__cap" data-open={f.id} style={`--c:${f.color}`} hidden>
          {focus === f.id ? <h1 class="ex__name">{f.name}</h1> : <h2 class="ex__name">{f.name}</h2>}
          <p class="ex__tag">
            <span lang="zh">{f.nameZh}</span> · {f.line}
          </p>
        </div>
      ))
    }
  </div>

  <aside class="ex__card" aria-live="polite" data-card hidden>
    <button type="button" class="ex__close" data-close aria-label="Close">×</button>
    <div data-card-body></div>
  </aside>


  {!home && <a class="ex__home" href="/">← The pillars</a>}

  <div class="ex__foot">
    <p class="ex__credit">
      {creditLine}
    </p>
    <a class="ex__down" href={home ? '#me' : '#list'}>{home ? 'About me ↓' : 'As a list ↓'}</a>

  </div>
</section>

<script>
  import { initExplorer } from '../scripts/explorer';

  const root = document.querySelector<HTMLElement>('[data-ex]');
  if (root) initExplorer(root);
</script>

<style>
  .ex {
    position: relative;
    height: calc(100svh - var(--nav-h));
    min-height: 520px;
    overflow: hidden;
    isolation: isolate;
    background: #050a1a;
    user-select: none;
    -webkit-user-select: none;
  }

  :global(.has-gl) .ex {
    background: transparent;
  }

  /* ── the still image (no WebGL) ── */
  .ex__still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: var(--pw);
    transform-origin: 0 0;
  }

  .ex__still.is-placed {
    inset: auto;
    left: 0;
    top: 0;
    object-fit: fill;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 18%);
    mask-image: linear-gradient(to right, transparent, #000 18%);
  }

  @media (max-aspect-ratio: 9 / 10) {
    .ex__still {
      object-position: var(--pt);
    }
  }

  :global(.has-gl) .ex__still {
    display: none;
  }

  .ex__veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgb(1 2 6 / 0.35), transparent 16%, transparent 70%, rgb(1 2 6 / 0.7));
    transition: opacity 600ms ease;
  }

  .ex.is-open .ex__veil {
    opacity: 0.55;
  }

  /* ── an open part's stars ── */
  .ex__stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .xpart {
    opacity: 0;
    visibility: hidden;
    transition: opacity 500ms ease, visibility 0s 500ms;
  }

  .xpart.is-open {
    opacity: 1;
    visibility: visible;
    transition: opacity 600ms ease 150ms;
  }

  .xline {
    stroke: var(--c);
    stroke-opacity: 0.55;
    stroke-width: 1.2;
  }

  .xstar {
    pointer-events: auto;
    cursor: pointer;
    outline: none;
  }

  .xstar__hit {
    fill: transparent;
  }

  .xstar__core {
    fill: #fff;
  }

  .xstar__ring {
    fill: none;
    stroke: var(--c);
    stroke-opacity: 0;
    transition: stroke-opacity var(--t-identify) var(--ease);
  }

  .xstar:hover .xstar__ring,
  .xstar.is-selected .xstar__ring {
    stroke-opacity: 0.85;
  }

  .xstar:focus-visible .xstar__ring {
    stroke: var(--selection-gold);
    stroke-opacity: 1;
    stroke-width: 2;
  }

  .xstar__name {
    font: 500 13px var(--font-display);
    fill: #f2f5f9;
    paint-order: stroke;
    stroke: #030610;
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  .xstar--bright .xstar__name {
    font-size: 14.5px;
  }

  .xstar__sub {
    font: 500 8.5px var(--font-mono);
    letter-spacing: 0.14em;
    fill: color-mix(in srgb, var(--c) 70%, #b7c6da);
    paint-order: stroke;
    stroke: #030610;
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .xstar:hover .xstar__name,
  .xstar.is-selected .xstar__name {
    fill: color-mix(in srgb, var(--c) 40%, #fff);
  }

  .xpart.is-open .xstar {
    animation: fade-in 600ms ease-out both;
    animation-delay: calc(200ms + var(--i) * 90ms);
  }

  /* ── the four parts ── */
  .part {
    position: absolute;
    left: var(--wx);
    top: var(--wy);
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    border-radius: 50%;
    color: var(--c);
    text-decoration: none;
    outline: none;
    z-index: 1;
    transition: opacity 900ms ease-out;
  }

  /* the parts come out with the sky, not before it */
  :global(html.js:not(.sky-ready)) .part {
    opacity: 0;
  }

  @media (max-aspect-ratio: 9 / 10) {
    .part {
      left: var(--tx);
      top: var(--ty);
    }
  }

  .ex.is-open .part {
    opacity: 0.35;
  }

  .ex.is-open .part.is-current {
    opacity: 0;
    pointer-events: none;
  }

  .part__halo,
  .part__ring,
  .part__core {
    position: absolute;
    left: 50%;
    top: 50%;
    border-radius: 50%;
    pointer-events: none;
  }

  .part__halo {
    width: 96px;
    height: 96px;
    margin: -48px 0 0 -48px;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--c) 55%, transparent), color-mix(in srgb, var(--c) 12%, transparent) 55%, transparent);
    mix-blend-mode: screen;
    opacity: 0;
    transform: scale(0.7);
    transition: opacity 500ms ease, transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .part__ring {
    width: 30px;
    height: 30px;
    margin: -15px 0 0 -15px;
    border: 1px solid color-mix(in srgb, var(--c) 70%, #fff);
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 300ms ease, transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* at rest, just a star among the others: faint, now and then a little brighter */
  .part__core {
    width: 4px;
    height: 4px;
    margin: -2px 0 0 -2px;
    background: #fff;
    box-shadow: 0 0 5px 1px color-mix(in srgb, var(--c) 70%, transparent);
    opacity: 0.55;
    transition: opacity 300ms ease, transform 300ms ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-motion='reduce'])) .part__core {
      animation: part-twinkle calc(7s + var(--i) * 1.3s) ease-in-out calc(var(--i) * -2.1s) infinite;
    }
  }

  @keyframes part-twinkle {
    0%, 100% { opacity: 0.4; }
    45% { opacity: 0.4; }
    55% { opacity: 0.95; }
    65% { opacity: 0.45; }
  }

  .part:hover .part__core,
  .part:focus-visible .part__core {
    opacity: 1;
    transform: scale(1.4);
    animation: none;
  }

  .part__label {
    position: absolute;
    left: calc(50% + 22px);
    top: calc(50% - 12px);
    display: flex;
    flex-direction: column;
    gap: 5px;
    white-space: nowrap;
    pointer-events: none;
    text-shadow: 0 0 3px #030610, 0 0 8px #030610, 0 0 16px rgb(3 6 16 / 0.85);
    opacity: 0.55;
    transition: opacity 300ms ease;
  }

  .part:hover .part__label,
  .part:focus-visible .part__label {
    opacity: 1;
  }

  .part--flip-wide .part__label {
    left: auto;
    right: calc(50% + 22px);
    align-items: flex-end;
  }

  @media (max-aspect-ratio: 9 / 10) {
    .part--flip-wide .part__label {
      left: calc(50% + 22px);
      right: auto;
      align-items: flex-start;
    }

    .part--flip-tall .part__label {
      left: auto;
      right: calc(50% + 22px);
      align-items: flex-end;
    }
  }

  .part__name {
    font: 500 12.5px/1 var(--font-mono);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--c) 70%, #fff);
  }

  .part__zh {
    font: 400 12px/1 var(--font-mono);
    letter-spacing: 0.12em;
    color: #c9d6e6;
  }

  .part:hover .part__halo,
  .part:focus-visible .part__halo {
    opacity: 1;
    transform: scale(1.2);
  }

  .part:hover .part__ring,
  .part:focus-visible .part__ring {
    opacity: 1;
    transform: scale(1.5);
  }

  .part:focus-visible .part__ring {
    border: 2px solid var(--selection-gold);
  }

  /* ── the caption: one quiet line of spaced capitals at the bottom centre ── */
  .ex__caption {
    position: absolute;
    left: 50%;
    bottom: 54px;
    transform: translateX(-50%);
    width: min(720px, calc(100% - 2 * var(--gutter)));
    text-align: center;
    pointer-events: none;
    z-index: 2;
  }

  .ex__cap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    animation: fade-in 700ms ease-out both;
  }

  .ex.is-open .ex__cap--home {
    display: none;
  }

  .ex__name {
    margin: 0 0 0 0.42em; /* the tracking after the last letter, so it centres */
    font: 500 clamp(15px, 1.5vw, 21px) / 1.2 var(--font-display);
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: #f4f2ee;
    text-shadow: 0 1px 16px rgb(0 0 0 / 0.9);
  }

  .ex__cap[data-open] .ex__name {
    color: color-mix(in srgb, var(--c) 35%, #f4f2ee);
  }

  .ex__tag {
    margin: 0;
    font: 400 12px/1.5 var(--font-mono);
    letter-spacing: 0.16em;
    color: rgb(230 226 220 / 0.68);
    text-shadow: 0 1px 10px rgb(0 0 0 / 0.95);
  }

  /* ── a star's card ── */
  .ex__card {
    position: absolute;
    top: 22px;
    right: var(--gutter);
    width: min(380px, calc(100% - 2 * var(--gutter)));
    max-height: calc(100% - 110px);
    overflow: auto;
    padding: 22px 22px 20px;
    border: 1px solid color-mix(in srgb, var(--c, #82d0dc) 35%, var(--hairline));
    border-radius: var(--radius-md);
    background: rgb(5 9 18 / 0.88);
    backdrop-filter: blur(8px);
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.5);
    z-index: 3;
    cursor: auto;
    user-select: text;
    -webkit-user-select: text;
  }

  .ex__close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--muted);
    font-size: 22px;
    cursor: pointer;
  }

  .ex__close:hover {
    color: var(--starlight);
  }

  /* ── tools and foot ── */
  .ex__foot {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 16px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 22px;
    z-index: 2;
  }

  .ex__credit {
    margin: 0;
    font: 400 11px/1.5 var(--font-mono);
    letter-spacing: 0.04em;
    color: #b7c6da;
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.95);
    cursor: auto;
  }

  .ex__credit a {
    color: inherit;
  }

  .ex__down {
    flex: none;
    font: 500 11.5px/1.4 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #d5e0ec;
    text-decoration: none;
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.95);
  }

  .ex__down:hover,
  .ex__home:hover {
    color: #fff;
  }

  .ex__home {
    position: absolute;
    left: var(--gutter);
    top: 22px;
    z-index: 2;
    font: 500 11.5px/1.4 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #d5e0ec;
    text-decoration: none;
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.95);
  }

  /* on a computer there is nothing below: no down link */
  @media (hover: hover) and (pointer: fine) {
    .ex__down {
      display: none;
    }
  }

  @media (max-aspect-ratio: 9 / 10) {
    .ex__caption {
      bottom: 78px;
    }

    .ex__foot {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 6px;
    }

    .ex__down {
      position: absolute;
      right: 0;
      bottom: 0;
    }

    .ex__credit {
      max-width: 72%;
      font-size: 10px;
    }

      .ex__card {
      top: auto;
      bottom: 0;
      right: 0;
      left: 0;
      width: auto;
      max-height: 58%;
      border-radius: var(--radius-md) var(--radius-md) 0 0;
    }
  }

  /* ── the opening (home): each part lights up, then the name ── */
  :global(html.sky-intro) .ex__cap--home {
    animation: ex-rise 1400ms cubic-bezier(0.2, 0.7, 0.2, 1) 900ms both;
  }

  :global(html.sky-intro) .ex__foot {
    animation: fade-in 900ms ease-out 3000ms both;
  }

  @keyframes ex-rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
</style>

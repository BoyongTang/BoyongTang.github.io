---
// One galaxy drawn in sky coordinates: a diffuse halo, decorative stars and a bright core.
// Purely visual (aria-hidden): the name and results live in the surrounding markup.
import type { Galaxy } from '../data/galaxies';
import { galaxySpray, galaxyStars, hueColor, starFill } from '../lib/universe';

interface Props {
  galaxy: Galaxy;
  uid: string;
}

const { galaxy: g, uid } = Astro.props;
const stars = galaxyStars(g);
const spray = galaxySpray(g);
const tint = hueColor[g.hue];
const id = `${uid}-${g.id}`;
---

<g class="galaxy-art" aria-hidden="true" data-x={g.x} data-y={g.y} data-r={g.r}>
  <defs>
    <radialGradient id={`${id}-halo`}>
      <stop offset="0" stop-color={tint} stop-opacity="0.24"></stop>
      <stop offset="0.4" stop-color="#7f9cc8" stop-opacity="0.11"></stop>
      <stop offset="1" stop-color="#2a3c5c" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id={`${id}-core`}>
      <stop offset="0" stop-color="#fff8ee" stop-opacity="1"></stop>
      <stop offset="0.18" stop-color="#ffd2a2" stop-opacity="0.75"></stop>
      <stop offset="0.45" stop-color="#e07a3c" stop-opacity="0.28"></stop>
      <stop offset="1" stop-color={tint} stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  <g class="galaxy-art__halowrap"><ellipse
    class="galaxy-art__halo"
    cx={g.x}
    cy={g.y}
    rx={g.r * 1.15}
    ry={g.r * 1.15 * g.tilt}
    transform={`rotate(${g.rotation} ${g.x} ${g.y})`}
    fill={`url(#${id}-halo)`}
  ></ellipse></g>
  <g class="galaxy-art__spray spray">
    {
      spray.map((l) => (
        <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} pathLength="100" stroke-opacity={l.o} class={`st-${l.kind}`} style={`--dur:${l.dur}s;--delay:${l.delay}s`} />
      ))
    }
  </g>
  <g class="galaxy-art__stars">
    {stars.map((s, i) => <circle cx={s.x} cy={s.y} r={s.r} opacity={s.o} fill={starFill(s)} class={s.glow ? `sh${(i % 3) + 1}` : undefined} />)}
  </g>
  <g class="galaxy-art__corewrap"><ellipse
    class="galaxy-art__core"
    cx={g.x}
    cy={g.y}
    rx={g.r * 0.24}
    ry={g.r * 0.24 * Math.max(g.tilt, 0.6)}
    transform={`rotate(${g.rotation} ${g.x} ${g.y})`}
    fill={`url(#${id}-core)`}
  ></ellipse></g>
</g>

<style is:global>
  /* "forming": added by script only (see src/scripts/form.ts). --d0 is this galaxy's start time. */
  .galaxy-art.is-forming .galaxy-art__stars circle {
    animation: star-burst 1150ms cubic-bezier(0.16, 0.84, 0.3, 1) both;
    animation-delay: calc(var(--d0, 0ms) + 150ms + var(--k, 0) * 750ms);
  }

  .galaxy-art.is-forming .galaxy-art__corewrap {
    transform-box: fill-box;
    transform-origin: center;
    animation: core-ignite 1100ms cubic-bezier(0.2, 1.5, 0.4, 1) both;
    animation-delay: var(--d0, 0ms);
  }

  .galaxy-art.is-forming .galaxy-art__spray {
    animation: fade-in 1600ms ease-out both;
    animation-delay: calc(var(--d0, 0ms) + 900ms);
  }

  .galaxy-art.is-forming .galaxy-art__halowrap {
    animation: fade-in 1700ms ease-out both;
    animation-delay: calc(var(--d0, 0ms) + 250ms);
  }

  @keyframes core-ignite {
    0% { transform: scale(0); opacity: 0; }
    35% { opacity: 1; }
  }
</style>

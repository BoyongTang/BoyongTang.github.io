---
// The detailed chart inside a galaxy: fine instrument rings, a dense star layer and one labelled star per
// real result. No connecting lines — a result's place says only "in this field".
import type { Galaxy } from '../data/galaxies';
import { galaxyStars, resultPositions } from '../lib/stars';
import { kindLabel, statusLabel, type Result } from '../lib/universe';

interface Props {
  galaxy: Galaxy;
  results: Result[];
  /** Render the dense star layer here (galaxy pages). The universe view adds it in the browser instead. */
  stars?: boolean;
}

const { galaxy: g, results, stars = false } = Astro.props;
const dense = stars ? galaxyStars(g, { detail: true }) : [];
const pos = resultPositions(g, results.length);
const R = g.r * 1.22;
const ticks = Array.from({ length: 72 }, (_, i) => i * 5);
const rad = (d: number) => ((d - 90) * Math.PI) / 180;
const s = g.r * 0.045; // result star size, in sky units
const f = g.r * 0.08; // label size, in sky units (≈ 12–13px once zoomed in)
// labels point inward, so they always stay inside the galaxy's frame
const short = (t: string) => (t.length > 26 ? `${t.slice(0, 24).trimEnd()}…` : t);
---

<g class="chart" data-chart={g.id}>
  <g class="chart__instrument" aria-hidden="true">
    <circle cx={g.x} cy={g.y} r={R} class="chart__ring" />
    <circle cx={g.x} cy={g.y} r={g.r * 0.62} class="chart__ring chart__ring--dash" />
    {
      ticks.map((d) => {
        const long = d % 30 === 0;
        const r1 = R + (long ? g.r * 0.06 : g.r * 0.03);
        return (
          <line
            x1={g.x + R * Math.cos(rad(d))}
            y1={g.y + R * Math.sin(rad(d))}
            x2={g.x + r1 * Math.cos(rad(d))}
            y2={g.y + r1 * Math.sin(rad(d))}
            class:list={['chart__tick', long && 'chart__tick--long']}
          />
        );
      })
    }
  </g>

  <g class="chart__dense" aria-hidden="true" data-dense>
    {dense.map((st) => <circle cx={st.x} cy={st.y} r={st.r} opacity={st.o} />)}
  </g>

  <g class="chart__results">
    {
      results.map((r, i) => {
        const p = pos[i];
        const dx = p.side === 'right' ? -s * 2.4 : s * 2.4;
        const anchor = p.side === 'right' ? 'end' : 'start';
        return (
          <a href={r.url} class="rstar" aria-label={`${kindLabel[r.kind]} ${r.code}: ${r.title}. ${statusLabel(r.status)}.`}>
            <circle cx={p.x} cy={p.y} r={s * 2.2} class="rstar__hit" />
            <circle cx={p.x} cy={p.y} r={s * 1.5} class="rstar__halo" />
            <circle cx={p.x} cy={p.y} r={s * 0.6} class="rstar__core" />
            <text x={p.x + dx} y={p.y - f * 0.1} text-anchor={anchor} font-size={f} class="rstar__title" lang={r.lang}>
              {short(r.title)}
            </text>
            <text x={p.x + dx} y={p.y + f * 1.05} text-anchor={anchor} font-size={f * 0.72} class="rstar__code">
              {r.code} · {kindLabel[r.kind].toUpperCase()}
            </text>
          </a>
        );
      })
    }
  </g>
</g>

<style is:global>
  .chart__ring {
    fill: none;
    stroke: #385467;
    stroke-opacity: 0.6;
    vector-effect: non-scaling-stroke;
  }

  .chart__ring--dash {
    stroke-dasharray: 2 6;
    stroke-opacity: 0.45;
  }

  .chart__tick {
    stroke: #385467;
    stroke-opacity: 0.7;
    vector-effect: non-scaling-stroke;
  }

  .chart__tick--long {
    stroke: #6f8ea0;
  }

  .chart__dense circle {
    fill: #e6f1ef;
  }

  .rstar {
    cursor: pointer;
    outline: none;
  }

  .rstar__hit {
    fill: transparent;
  }

  .rstar__halo {
    fill: none;
    stroke: #e9c18f;
    stroke-opacity: 0.55;
    vector-effect: non-scaling-stroke;
    transition: stroke-opacity var(--t-identify) var(--ease);
  }

  .rstar__core {
    fill: #e9c18f;
  }

  .rstar__title {
    font-family: var(--font-display);
    font-weight: 500;
    fill: #ecf3f0;
    paint-order: stroke;
    stroke: #071320;
    stroke-width: 0.25em;
    stroke-linejoin: round;
    transition: fill var(--t-identify) var(--ease);
  }

  .rstar__code {
    font-family: var(--font-mono);
    letter-spacing: 0.12em;
    fill: #8fa9b3;
    paint-order: stroke;
    stroke: #071320;
    stroke-width: 0.25em;
  }

  .rstar:hover .rstar__title,
  .rstar:focus-visible .rstar__title {
    fill: #82d0dc;
  }

  .rstar:hover .rstar__halo {
    stroke-opacity: 1;
  }

  .rstar:focus-visible .rstar__halo {
    stroke: #e9c18f;
    stroke-width: 2.5;
    stroke-opacity: 1;
  }
</style>

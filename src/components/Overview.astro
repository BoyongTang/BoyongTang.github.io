---
// The home page's second screen, below the pillars: the same content as the stars, laid out as a plain
// academic page. On the left your card (src/data/profile.ts) stays in view; on the right, one section per
// part, newest first, from src/data/stars.ts. Nothing here needs editing: change the data and both screens
// follow.
import { facetById, type FacetId } from '../data/facets';
import { profile } from '../data/profile';
import type { SkyFacet, SkyItem } from '../lib/sky';

interface Props {
  sky: SkyFacet[];
}

const { sky } = Astro.props;
const part = (id: FacetId) => sky.find((f) => f.id === id);
/** A part's stars, newest first (they are written oldest first). */
const newest = (id: FacetId) => [...(part(id)?.items ?? [])].reverse();
/** Honors: latest year first; within a year, in the order they are written. */
const year = (s: SkyItem) => Number(/\d{4}/.exec(s.sub ?? '')?.[0] ?? 0);
const byYear = (id: FacetId) => [...(part(id)?.items ?? [])].sort((a, b) => year(b) - year(a));
const color = (id: FacetId) => facetById.get(id)?.color ?? '#82d0dc';

// an author list split round your own name, so it can be shown in bold
const authorParts = (authors: string) => authors.split(profile.name).flatMap((p, i) => (i ? [null, p] : [p]));
const initials = profile.name
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .toUpperCase();
const linkMark = (href: string) => (href.startsWith('mailto:') ? ' →' : /^https?:/.test(href) ? ' ↗' : ' →');

const sections: { id: FacetId; title: string; zh: string; items: SkyItem[] }[] = [
  { id: 'news', title: 'News', zh: '动态', items: newest('news') },
  { id: 'research', title: 'Research', zh: '研究', items: newest('research') },
  { id: 'honors', title: 'Honors & Awards', zh: '荣誉', items: byYear('honors') },
  { id: 'works', title: 'Works', zh: '作品', items: newest('works') },
  { id: 'contact', title: 'Contact', zh: '联系', items: part('contact')?.items ?? [] },
];
---

<section class="ov" id="about" aria-label={`${profile.name}: everything on one page`}>
  <div class="ov__wrap">
    <aside class="ov__side">
      <div class="ov__card">
        <div class="ov__mark" aria-hidden="true">{initials}</div>
        <h2 class="ov__name">{profile.name}</h2>
        {profile.role && <p class="ov__role">{profile.role}</p>}
        {(profile.affiliation || profile.location) && <p class="ov__aff">{[profile.affiliation, profile.location].filter(Boolean).join(' · ')}</p>}
        {
          profile.interests.length > 0 && (
            <ul class="ov__tags" aria-label="Research interests">
              {profile.interests.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          )
        }
        <p class="ov__btns">
          {profile.email && <a class="btn" href={`mailto:${profile.email}`}>Scholar email →</a>}
          {profile.generalEmail && <a class="btn" href={`mailto:${profile.generalEmail}`}>General email →</a>}
          {profile.googleScholar && <a class="btn" href={profile.googleScholar} rel="noopener">Google Scholar ↗</a>}
          {profile.github && <a class="btn" href={profile.github} rel="noopener">GitHub ↗</a>}
          {profile.cv && <a class="btn" href={profile.cv}>CV ↓</a>}
        </p>
      </div>
    </aside>

    <div class="ov__main">
      {
        (profile.bio || profile.bioZh) && (
          <section class="ov__sec" style={`--c:${color('intro')}`} aria-labelledby="ov-about">
            <h3 class="ov__head" id="ov-about">
              About <span lang="zh">个人介绍</span>
            </h3>
            {profile.bio && <p class="ov__text">{profile.bio}</p>}
            {profile.bioZh && (
              <p class="ov__text" lang="zh">
                {profile.bioZh}
              </p>
            )}
          </section>
        )
      }

      {
        sections.map((sec) => (
          <section class="ov__sec" style={`--c:${color(sec.id)}`} aria-labelledby={`ov-${sec.id}`}>
            <h3 class="ov__head" id={`ov-${sec.id}`}>
              {sec.title} <span lang="zh">{sec.zh}</span>
            </h3>

            {sec.items.length === 0 && (
              <p class="ov__empty">
                Uncharted · <span lang="zh">待探索</span> · Coming soon.
              </p>
            )}

            {/* News: a date, then what happened */}
            {sec.id === 'news' && sec.items.length > 0 && (
              <ol class="ov__rows">
                {sec.items.map((s) => (
                  <li>
                    <span class="ov__when">{s.sub}</span>
                    <span>
                      <strong class="ov__strong">{s.title ?? s.name}</strong>
                      {s.text && <> — {s.text}</>}
                      {s.links?.map((l) => (
                        <>
                          {' '}
                          <a class="ov__inline" href={l.href} rel={l.external ? 'noopener' : undefined}>
                            {l.label}
                            {linkMark(l.href)}
                          </a>
                        </>
                      ))}
                    </span>
                  </li>
                ))}
              </ol>
            )}

            {/* Research and Works: a card per paper or project, its figure on the left */}
            {(sec.id === 'research' || sec.id === 'works') && sec.items.length > 0 && (
              <div class="ov__papers">
                {sec.items.map((s) => (
                  <article class:list={['ov__paper', !s.image && 'ov__paper--plain']}>
                    {s.image && (
                      <a class="ov__fig" href={s.image.src} target="_blank" rel="noopener" title="Open the full-size figure">
                        <img src={s.image.src} alt={s.image.alt} loading="lazy" decoding="async" />
                      </a>
                    )}
                    <div class="ov__body">
                      <p class="ov__kind">
                        {[s.chain, s.kind].filter(Boolean).join(' · ')}
                        {s.sub && <span class="ov__badge">{s.sub}</span>}
                      </p>
                      <h4 class="ov__title">{s.title ?? s.name}</h4>
                      {s.authors && (
                        <p class="ov__authors">{authorParts(s.authors).map((p) => (p === null ? <strong>{profile.name}</strong> : p))}</p>
                      )}
                      {s.text && <p class="ov__text">{s.text}</p>}
                      {s.links && s.links.length > 0 && (
                        <p class="ov__chips">
                          {s.links.map((l) => (
                            <a href={l.href} rel={l.external ? 'noopener' : undefined}>
                              {l.label}
                              {linkMark(l.href)}
                            </a>
                          ))}
                        </p>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            )}

            {/* Honors: a year, then the award (its level after it, unless the name already says it) */}
            {sec.id === 'honors' && sec.items.length > 0 && (
              <ul class="ov__rows">
                {sec.items.map((s) => {
                  const what = s.title ?? s.name;
                  return (
                    <li>
                      <span class="ov__when">{s.sub}</span>
                      <span>
                        <strong class="ov__strong">{what}</strong>
                        {s.kind && !what.includes(s.kind) && <span class="ov__dim"> · {s.kind}</span>}
                      </span>
                    </li>
                  );
                })}
              </ul>
            )}

            {/* Contact: the links */}
            {sec.id === 'contact' && sec.items.length > 0 && (
              <p class="ov__btns ov__btns--left">
                {sec.items.flatMap((s) =>
                  (s.links ?? []).map((l) => (
                    <a class="btn" href={l.href} rel={l.external ? 'noopener' : undefined}>
                      {s.name}
                      {linkMark(l.href)}
                    </a>
                  )),
                )}
              </p>
            )}
          </section>
        ))
      }

      <p class="ov__top"><a href="#">↑ Back to the pillars</a></p>
    </div>
  </div>
</section>

<script>
  // The second screen comes in as you reach it: each heading, line and card rises into place the first time
  // it scrolls into view (together, they follow one another). And a card is lit where the pointer is.
  const ov = document.querySelector<HTMLElement>('.ov');
  if (ov) {
    const items = [...ov.querySelectorAll<HTMLElement>('.ov__card, .ov__head, .ov__sec > .ov__text, .ov__empty, .ov__rows > li, .ov__paper, .ov__sec > .ov__btns, .ov__top')];
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          let n = 0;
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            el.style.transitionDelay = `${Math.min(n++, 6) * 70}ms`;
            el.classList.add('is-in');
            io.unobserve(el);
            // the delay is only for arriving: afterwards hover answers at once
            el.addEventListener('transitionend', () => (el.style.transitionDelay = ''), { once: true });
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      for (const el of items) {
        el.classList.add('rv');
        io.observe(el);
      }
    }

    for (const card of ov.querySelectorAll<HTMLElement>('.ov__card, .ov__paper')) {
      card.addEventListener(
        'pointermove',
        (ev) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--gx', `${(ev.clientX - r.left).toFixed(0)}px`);
          card.style.setProperty('--gy', `${(ev.clientY - r.top).toFixed(0)}px`);
        },
        { passive: true },
      );
    }
  }
</script>

<style is:global>
  /* arriving (classes set by the script above; without JavaScript everything is simply there) */
  .ov .rv {
    opacity: 0;
    transform: translateY(18px);
  }

  .ov .rv.is-in {
    opacity: 1;
    transform: none;
    transition:
      opacity 700ms var(--ease),
      transform 800ms var(--ease),
      border-color 300ms var(--ease),
      box-shadow 300ms var(--ease);
  }
</style>

<style>
  .ov {
    position: relative;
    padding: 96px var(--gutter) 72px;
    /* the sky shows through, darker: it fades in from the pillars above */
    background: linear-gradient(180deg, rgb(3 5 12 / 0), rgb(3 5 12 / 0.86) 120px, rgb(3 5 12 / 0.9));
    color: var(--muted);
  }

  .ov__wrap {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 48px;
    max-width: 1080px;
    margin: 0 auto;
  }

  /* ── your card, staying in view ── */
  .ov__side {
    position: relative;
  }

  .ov__card {
    position: sticky;
    top: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 28px 22px 22px;
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius-md);
    background: rgb(5 9 18 / 0.7);
    backdrop-filter: blur(6px);
    text-align: center;
    --c: #ff8f7d;
  }

  /* a card is lit where the pointer is, in its part's colour, and its edge warms */
  .ov__card,
  .ov__paper {
    isolation: isolate;
    overflow: hidden;
    transition: border-color 300ms var(--ease), box-shadow 300ms var(--ease);
  }

  .ov__card::before,
  .ov__paper::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(340px circle at var(--gx, 50%) var(--gy, 0%), color-mix(in srgb, var(--c) 28%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity 400ms ease;
    pointer-events: none;
  }

  .ov__card:hover,
  .ov__paper:hover {
    border-color: color-mix(in srgb, var(--c) 50%, var(--hairline));
    box-shadow: 0 14px 44px -18px color-mix(in srgb, var(--c) 55%, transparent), 0 0 0 1px color-mix(in srgb, var(--c) 12%, transparent);
  }

  .ov__card:hover::before,
  .ov__paper:hover::before {
    opacity: 1;
  }

  .ov__mark {
    position: relative;
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    margin-bottom: 6px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, #ff8f7d 55%, transparent);
    background: radial-gradient(circle at 35% 30%, rgb(255 143 125 / 0.35), rgb(5 9 18 / 0.9) 70%);
    font: 500 26px/1 var(--font-display);
    letter-spacing: 0.08em;
    color: var(--starlight);
    box-shadow: 0 0 26px -6px rgb(255 143 125 / 0.55);
  }

  /* a point of light circles the mark */
  .ov__mark::before {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    background: conic-gradient(from 0deg, transparent 0 58%, rgb(255 143 125 / 0.7) 82%, #ffe2b8 96%, #fff 99%, transparent);
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1.2px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1.2px));
    opacity: 0.9;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-motion='reduce'])) .ov__mark::before {
      animation: ov-orbit 7s linear infinite;
    }

    :global(html:not([data-motion='reduce'])) .ov__head::before {
      animation: ov-twinkle 3.6s ease-in-out infinite;
    }

    :global(html:not([data-motion='reduce'])) .ov__head::after {
      animation: ov-flow 7s linear infinite;
    }
  }

  @keyframes ov-orbit {
    to { transform: rotate(360deg); }
  }

  @keyframes ov-twinkle {
    0%, 100% { box-shadow: 0 0 0 2px color-mix(in srgb, var(--c) 45%, transparent), 0 0 12px 2px var(--c); }
    50% { box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 30%, transparent), 0 0 20px 5px var(--c); }
  }

  @keyframes ov-flow {
    from { background-position: -40% 0; }
    to { background-position: 140% 0; }
  }

  .ov__name {
    margin: 0;
    font: 500 22px/1.25 var(--font-display);
    color: var(--starlight);
  }

  .ov__role,
  .ov__aff {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
  }

  .ov__aff {
    color: var(--dim);
  }

  .ov__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin: 8px 0 4px;
    padding: 0;
    list-style: none;
  }

  .ov__tags li {
    padding: 3px 9px;
    border: 1px solid var(--hairline-soft);
    border-radius: 999px;
    font: 500 11.5px/1.4 var(--font-mono);
    color: var(--muted);
  }

  .ov__btns {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 8px 0 0;
  }

  .ov__btns--left {
    justify-content: flex-start;
    margin: 0;
  }

  /* ── the sections ── */
  .ov__main {
    display: flex;
    flex-direction: column;
    gap: 44px;
    min-width: 0;
  }

  .ov__sec {
    scroll-margin-top: 24px;
  }

  /* light runs along the rule under each heading, in the part's colour */
  .ov__head::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--c) 75%, #fff), transparent) -40% 0 / 26% 100% no-repeat;
    pointer-events: none;
  }

  .ov__head {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--hairline-soft);
    font: 500 21px/1.3 var(--font-display);
    color: var(--starlight);
  }

  /* the part's star, in its colour */
  .ov__head::before {
    content: '';
    flex: none;
    align-self: center;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--c) 45%, transparent), 0 0 12px 2px var(--c);
  }

  .ov__head span {
    font: 400 14px/1 var(--font-mono);
    letter-spacing: 0.12em;
    color: color-mix(in srgb, var(--c) 65%, #b9cfd6);
  }

  .ov__text {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.65;
  }

  .ov__empty {
    margin: 0;
    font: 500 12px/1.5 var(--font-mono);
    letter-spacing: 0.16em;
    color: var(--dim);
  }

  /* News and Honors: a date column, then the line */
  .ov__rows {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
    line-height: 1.6;
  }

  .ov__rows li {
    display: grid;
    grid-template-columns: 7.5em minmax(0, 1fr);
    gap: 14px;
  }

  .ov__when {
    font: 400 13px/1.85 var(--font-mono);
    color: color-mix(in srgb, var(--c) 55%, #8fa9b3);
  }

  .ov__strong {
    font-weight: 500;
    color: var(--starlight);
  }

  .ov__dim {
    color: var(--dim);
  }

  .ov__inline {
    color: color-mix(in srgb, var(--c) 55%, #ecf3f0);
    white-space: nowrap;
  }

  /* Research and Works: a card each, the figure on the left */
  .ov__papers {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ov__paper {
    position: relative;
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 20px;
    padding: 18px;
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius-md);
    background: rgb(5 9 18 / 0.55);
  }

  .ov__paper--plain {
    grid-template-columns: minmax(0, 1fr);
  }

  .ov__fig {
    display: grid;
    place-items: center;
    align-self: start;
    padding: 8px;
    border-radius: var(--radius-sm);
    background: #f6f7f9;
    cursor: zoom-in;
    overflow: hidden;
  }

  .ov__fig img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 600ms var(--ease);
  }

  .ov__fig:hover img {
    transform: scale(1.04);
  }

  .ov__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .ov__kind {
    margin: 0;
    font: 500 11px/1.4 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--c) 70%, #8fa9b3);
  }

  .ov__badge {
    display: inline-block;
    margin-left: 8px;
    padding: 2px 8px;
    border: 1px solid color-mix(in srgb, var(--c) 55%, transparent);
    border-radius: 999px;
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: color-mix(in srgb, var(--c) 45%, #fff);
    background: color-mix(in srgb, var(--c) 14%, transparent);
    vertical-align: 1px;
  }

  .ov__title {
    margin: 0;
    font: 500 17px/1.4 var(--font-display);
    color: var(--starlight);
  }

  .ov__authors {
    margin: 0;
    font-size: 14px;
    color: var(--dim);
  }

  .ov__authors strong {
    font-weight: 600;
    color: var(--starlight);
  }

  .ov__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 2px 0 0;
  }

  .ov__chips a {
    padding: 3px 10px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    font: 500 12px/1.5 var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--starlight);
    text-decoration: none;
    transition: border-color var(--t-identify) var(--ease), box-shadow 300ms var(--ease), background-color var(--t-identify) var(--ease);
  }

  .ov__chips a:hover {
    border-color: var(--c);
    background: color-mix(in srgb, var(--c) 12%, transparent);
    box-shadow: 0 0 18px -6px var(--c);
  }

  .ov__top {
    margin: 0;
    font: 500 12px/1.5 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ov__top a {
    color: var(--dim);
    text-decoration: none;
  }

  .ov__top a:hover {
    color: var(--starlight);
  }

  /* phones and narrow windows: one column, the card on top */
  @media (max-width: 860px) {
    .ov {
      padding-top: 64px;
    }

    .ov__wrap {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .ov__card {
      position: static;
    }

    .ov__paper {
      grid-template-columns: minmax(0, 1fr);
    }

    .ov__rows li {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }
</style>

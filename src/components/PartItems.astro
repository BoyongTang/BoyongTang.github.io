---
// One part's stars as entries: what the explorer's star cards are copied from (src/scripts/explorer.ts), and
// the plain list visitors without JavaScript read (src/components/Explorer.astro).
import { profile } from '../data/profile';
import type { SkyFacet } from '../lib/sky';

interface Props {
  f: SkyFacet;
}

const { f } = Astro.props;

// an author list split round your own name, so it can be shown in bold
const authorParts = (authors: string) => authors.split(profile.name).flatMap((part, i) => (i ? [null, part] : [part]));
---

<ol class="slist__items" style={`--c:${f.color}`}>
  {
        f.items.map((s) => {
          const related = f.lines.filter(([a, b]) => a.id === s.id || b.id === s.id).map(([a, b]) => (a.id === s.id ? b : a));
          return (
            <li id={`i-${s.id}`} class="sitem">
              <article class="sitem__body" data-entry={s.id}>
                {(s.chain || s.kind || s.sub) && (
                  <p class="sitem__kind">
                    {[s.chain, s.kind].filter(Boolean).join(' · ')}
                    {s.sub && <span class="sitem__badge">{s.sub}</span>}
                  </p>
                )}
                <h3 class="sitem__name">
                  {s.name}
                  {s.nameZh && <span lang="zh"> {s.nameZh}</span>}
                </h3>
                {s.title && <p class="sitem__title">{s.title}</p>}
                {s.authors && (
                  <p class="sitem__authors">{authorParts(s.authors).map((p) => (p === null ? <strong>{profile.name}</strong> : p))}</p>
                )}
                {s.image && (
                  <figure class="sitem__fig">
                    <img src={s.image.src} alt={s.image.alt} decoding="async" />
                  </figure>
                )}
                {s.text && <p class="sitem__text">{s.text}</p>}
                {related.length > 0 && (
                  <p class="sitem__rel">
                    Linked to{' '}
                    {related.map((r, i) => (
                      <>
                        {i > 0 && ', '}
                        <a href={`#i-${r.id}`} data-goto={r.id}>
                          {r.name}
                        </a>
                      </>
                    ))}
                  </p>
                )}
                {s.links && s.links.length > 0 && (
                  <p class="sitem__links">
                    {s.links.map((l) => (
                      <a class="btn" href={l.href} rel={l.external ? 'noopener' : undefined}>
                        {l.label}
                        {l.external && !l.href.startsWith('mailto:') ? ' ↗' : ' →'}
                      </a>
                    ))}
                  </p>
                )}
              </article>
            </li>
          );
        })
  }
</ol>

<style is:global>
  .slist__items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .sitem {
    padding: 18px 18px 16px;
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius-md);
    background: rgb(5 9 18 / 0.55);
    backdrop-filter: blur(4px);
    scroll-margin-top: calc(var(--nav-h) + 20px);
  }

  .sitem:target {
    border-color: var(--c);
  }

  .sitem__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .sitem__kind {
    margin: 0;
    font: 500 11.5px/1.4 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--c) 70%, #8fa9b3);
  }

  .sitem__name {
    margin: 0;
    font: 500 21px/1.25 var(--font-display);
    color: var(--starlight);
  }

  .sitem__text {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
  }

  /* a paper's figure: most are drawn dark on white, so they sit on a light panel */
  .sitem__fig {
    margin: 0;
    padding: 10px;
    border-radius: var(--radius-sm);
    background: #f6f7f9;
  }

  .sitem__fig img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* the status, e.g. Under Review: a small pill after the kind */
  .sitem__badge {
    display: inline-block;
    margin-left: 8px;
    padding: 2px 8px;
    border: 1px solid color-mix(in srgb, var(--c) 55%, transparent);
    border-radius: 999px;
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: color-mix(in srgb, var(--c) 45%, #fff);
    background: color-mix(in srgb, var(--c) 14%, transparent);
    vertical-align: 1px;
  }

  .sitem__title {
    margin: -4px 0 0;
    color: var(--starlight);
    font-size: 15px;
    line-height: 1.45;
  }

  .sitem__authors {
    margin: 0;
    color: var(--dim);
    font-size: 14px;
    line-height: 1.5;
  }

  .sitem__authors strong {
    color: color-mix(in srgb, var(--c) 30%, #fff);
    font-weight: 600;
  }

  .sitem__rel {
    margin: 0;
    color: var(--dim);
    font-size: 14px;
  }

  .sitem__rel a {
    color: color-mix(in srgb, var(--c) 65%, #ecf3f0);
  }

  .sitem__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 4px 0 0;
  }
</style>

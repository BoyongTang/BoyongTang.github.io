---
// One part's stars as entries: what the explorer's star cards are copied from (src/scripts/explorer.ts), and
// the plain list visitors without JavaScript read (src/components/Explorer.astro).
import type { SkyFacet } from '../lib/sky';

interface Props {
  f: SkyFacet;
}

const { f } = Astro.props;
---

<ol class="slist__items" style={`--c:${f.color}`}>
  {
        f.items.map((s) => {
          const related = f.lines.filter(([a, b]) => a.id === s.id || b.id === s.id).map(([a, b]) => (a.id === s.id ? b : a));
          return (
            <li id={`i-${s.id}`} class="sitem">
              <article class="sitem__body" data-entry={s.id}>
                {(s.chain || s.kind || s.sub) && <p class="sitem__kind">{[s.chain, s.kind, s.sub].filter(Boolean).join(' · ')}</p>}
                <h3 class="sitem__name">
                  {s.name}
                  {s.nameZh && <span lang="zh"> {s.nameZh}</span>}
                </h3>
                {s.text && <p class="sitem__text">{s.text}</p>}
                {related.length > 0 && (
                  <p class="sitem__rel">
                    Linked to{' '}
                    {related.map((r, i) => (
                      <>
                        {i > 0 && ', '}
                        <a href={`#i-${r.id}`} data-goto={r.id}>
                          {r.name}
                        </a>
                      </>
                    ))}
                  </p>
                )}
                {s.links && s.links.length > 0 && (
                  <p class="sitem__links">
                    {s.links.map((l) => (
                      <a class="btn" href={l.href} rel={l.external ? 'noopener' : undefined}>
                        {l.label}
                        {l.external && !l.href.startsWith('mailto:') ? ' ↗' : ' →'}
                      </a>
                    ))}
                  </p>
                )}
              </article>
            </li>
          );
        })
  }
</ol>

<style is:global>
  .slist__items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .sitem {
    padding: 18px 18px 16px;
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius-md);
    background: rgb(5 9 18 / 0.55);
    backdrop-filter: blur(4px);
    scroll-margin-top: calc(var(--nav-h) + 20px);
  }

  .sitem:target {
    border-color: var(--c);
  }

  .sitem__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .sitem__kind {
    margin: 0;
    font: 500 11.5px/1.4 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--c) 70%, #8fa9b3);
  }

  .sitem__name {
    margin: 0;
    font: 500 21px/1.25 var(--font-display);
    color: var(--starlight);
  }

  .sitem__text {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
  }

  .sitem__rel {
    margin: 0;
    color: var(--dim);
    font-size: 14px;
  }

  .sitem__rel a {
    color: color-mix(in srgb, var(--c) 65%, #ecf3f0);
  }

  .sitem__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 4px 0 0;
  }
</style>

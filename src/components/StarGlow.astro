---
// Shared star glows, after the Event Horizon sky: a bright star is a soft gaussian point, not a disc.
// Any SVG on the page can use them as fill="url(#sg-w)" (white), #sg-b (icy blue) or #sg-a (amber).
// Also the shared motion for the sky: a slow shimmer on bright stars, streaks streaming out of a core.
import { starColor, type StarKind } from '../lib/stars';

const kinds = Object.entries(starColor) as [StarKind, string][];
// exp(-(x / 0.3)²), sampled, with a hot white centre
const falloff = [0, 0.12, 0.25, 0.42, 0.65, 1].map((x) => [x, Math.exp(-((x / 0.3) ** 2))]);
---

<svg class="star-glow-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    {
      kinds.map(([k, col]) => (
        <radialGradient id={`sg-${k}`}>
          <stop offset="0" stop-color="#ffffff" stop-opacity="1" />
          {falloff.slice(1).map(([x, a]) => (
            <stop offset={x} stop-color={col} stop-opacity={Math.max(0, a).toFixed(3)} />
          ))}
        </radialGradient>
      ))
    }
  </defs>
</svg>

<style is:global>
  .star-glow-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* bright stars breathe a little: fill-opacity multiplies the star's own opacity */
  .sh1 { animation: star-shimmer 5.5s ease-in-out infinite; }
  .sh2 { animation: star-shimmer 8s ease-in-out -3s infinite; }
  .sh3 { animation: star-shimmer 11s ease-in-out -7s infinite; }

  @keyframes star-shimmer {
    0%, 100% { fill-opacity: 1; }
    50% { fill-opacity: 0.72; }
  }

  /* streaks sprayed from a galaxy's core (lib/stars.ts galaxySpray) */
  .spray line {
    fill: none;
    stroke-width: 0.8px;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .spray .st-b { stroke: #b8d0f5; }
  .spray .st-a { stroke: #ff9a5a; }

  /* with motion, each streak's light runs outward along it; without, it simply stays put */
  @media (prefers-reduced-motion: no-preference) {
    html:not([data-motion='reduce']) .spray line {
      stroke-dasharray: 42 160;
      animation: spray-stream var(--dur, 6s) linear var(--delay, 0s) infinite;
    }
  }

  @keyframes spray-stream {
    from { stroke-dashoffset: 42; }
    to { stroke-dashoffset: -100; }
  }
</style>

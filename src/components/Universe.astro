---
// The research universe: one unnamed galaxy per field. Selecting a galaxy zooms into it and lists its
// results. Without JavaScript every galaxy is a plain link to its own page, and the List view is in the page.
import { galaxies, galaxyCode, VIEW } from '../data/galaxies';
import { ambientStars, kindLabel, resultsIn, starFill, statusLabel, type Result } from '../lib/universe';
import GalaxyArt from './GalaxyArt.astro';
import GalaxyChart from './GalaxyChart.astro';

interface Props {
  results: Result[];
  /** 'home' sits beside the profile; 'full' is the /atlas/ page. */
  mode?: 'home' | 'full';
  heading?: string;
}

const { results, mode = 'home', heading = 'Research universe' } = Astro.props;
const uid = `u-${mode}`;
const stars = ambientStars(mode === 'full' ? 320 : 240);
const C = { x: VIEW.w / 2, y: VIEW.h / 2 };
const ticks = Array.from({ length: 72 }, (_, i) => i * 5);
const rad = (d: number) => ((d - 90) * Math.PI) / 180;
const count = (n: number) => String(n).padStart(2, '0');
const groups = galaxies.map((g) => ({ g, items: resultsIn(results, g.id) }));
---

<section class:list={['universe', `universe--${mode}`]} data-universe data-mode={mode} aria-labelledby={`${uid}-title`}>
  <script is:inline>
    // Hold the sky dark before first paint when the opening will play (once per visit, motion allowed).
    // The module script starts it when the map is on screen; if that script never runs, the sky shows after 4 s.
    (function () {
      var root = document.currentScript && document.currentScript.parentElement;
      if (!root) return;
      var reduce = document.documentElement.dataset.motion === 'reduce' || matchMedia('(prefers-reduced-motion: reduce)').matches;
      var seen = false;
      try { seen = sessionStorage.getItem('oq.intro.' + root.dataset.mode) === '1'; } catch (e) {}
      if (reduce || seen || (root.dataset.mode === 'full' && location.hash.length > 1)) return;
      root.classList.add('is-intro-wait');
      setTimeout(function () { if (!root.dataset.introReady) root.classList.remove('is-intro-wait'); }, 4000);
    })();
  </script>
  <header class="universe__bar">
    <h2 class="eyebrow" id={`${uid}-title`}>{heading}</h2>
    <div class="universe__bar-right">
      <button type="button" class="universe__replay" data-replay hidden>↻ Replay</button>
      {mode === 'home' && <a class="universe__open" href="/atlas/">Full atlas ↗</a>}
      <div class="toggle" role="group" aria-label="View">
        <button type="button" data-view="map" aria-pressed="true">MAP</button>
        <button type="button" data-view="list" aria-pressed="false">LIST</button>
      </div>
    </div>
  </header>

  <div class="universe__map" data-map>
    <svg
      class="universe__svg"
      viewBox={`0 0 ${VIEW.w} ${VIEW.h}`}
      preserveAspectRatio="xMidYMid meet"
      role="group"
      aria-label="Research universe. Each galaxy is one field; select a galaxy to see its results. The same content is in the List view."
      data-svg
    >
      <rect x="-3000" y="-3000" width="7000" height="7000" fill="transparent" data-bg></rect>

      <g class="u-ambient" aria-hidden="true">
        {stars.map((s) => <circle cx={s.x} cy={s.y} r={s.r} opacity={s.o} fill={starFill(s)} class:list={['u-star', s.twinkle ? `tw tw${s.twinkle}` : s.shimmer && `sh${s.shimmer}`]} />)}
      </g>

      <g class="u-instrument" aria-hidden="true">
        <circle cx={C.x} cy={C.y} r="330" class="u-ring u-ring--scale" />
        <circle cx={C.x} cy={C.y} r="420" class="u-ring" />
        {
          ticks.map((d) => {
            const long = d % 30 === 0;
            const r1 = long ? 342 : 336;
            return (
              <line
                x1={C.x + 330 * Math.cos(rad(d))}
                y1={C.y + 330 * Math.sin(rad(d))}
                x2={C.x + r1 * Math.cos(rad(d))}
                y2={C.y + r1 * Math.sin(rad(d))}
                class:list={['u-tick', long && 'u-tick--long']}
                style={`--k:${(d / 360).toFixed(3)}`}
              />
            );
          })
        }
      </g>

      {
        groups.map(({ g, items }, i) => (
          <g class="galaxy-wrap" data-wrap={g.id} style={`--gi:${i}`}>
          <a
            href={`/atlas/${g.id}/`}
            class="galaxy"
            data-galaxy={g.id}
            data-x={g.x}
            data-y={g.y}
            data-r={g.r}
            aria-label={`${g.name}: ${items.length} ${items.length === 1 ? 'result' : 'results'}`}
          >
            <ellipse
              class="galaxy__hit"
              cx={g.x}
              cy={g.y}
              rx={g.r * 1.1}
              ry={Math.max(g.r * 1.1 * g.tilt, g.r * 0.7)}
              transform={`rotate(${g.rotation} ${g.x} ${g.y})`}
            />
            <ellipse
              class="galaxy__reticle"
              cx={g.x}
              cy={g.y}
              rx={g.r * 1.28}
              ry={g.r * 1.28 * Math.max(g.tilt, 0.55)}
              transform={`rotate(${g.rotation} ${g.x} ${g.y})`}
            />
            <GalaxyArt galaxy={g} uid={uid} />
          </a>
          <g class="galaxy__detail">
            <GalaxyChart galaxy={g} results={items} />
          </g>
          </g>
        ))
      }
    </svg>

    <p class="universe__hint" aria-hidden="true">Select a galaxy to look inside</p>

    <div class="universe__panels" data-panels hidden>
      {
        groups.map(({ g, items }) => (
          <section class="universe__panel" data-panel={g.id} hidden tabindex="-1" aria-labelledby={`${uid}-${g.id}-name`}>
            <button type="button" class="universe__close" data-back aria-label="Back to all galaxies">
              ×
            </button>
            <p class="eyebrow">Galaxy / {galaxyCode(g)}</p>
            <h3 id={`${uid}-${g.id}-name`}>{g.name}</h3>
            {g.nameZh && <p class="universe__zh" lang="zh">{g.nameZh}</p>}
            {g.blurb && <p class="universe__blurb">{g.blurb}</p>}
            <p class="eyebrow universe__count">Results / {count(items.length)}</p>
            {items.length ? (
              <ul class="result-list">
                {items.map((r) => (
                  <li>
                    <a href={r.url} {...(r.external ? { rel: 'noopener' } : {})}>
                      <span class="code">{r.code}</span>
                      <span class="result-list__title" lang={r.lang}>{r.title}</span>
                      <span class="result-list__meta">
                        {kindLabel[r.kind]} · {statusLabel(r.status)}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="universe__empty">No public results yet.</p>
            )}
            <div class="universe__actions">
              <button type="button" class="btn btn--ghost" data-back>
                ← All galaxies
              </button>
              <a class="btn" href={`/atlas/${g.id}/`}>
                Open galaxy →
              </a>
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <div class="universe__list" data-list hidden>
    {
      groups.map(({ g, items }) => (
        <section class="universe__group">
          <h3>
            <a href={`/atlas/${g.id}/`}>
              <span class="code">{galaxyCode(g)}</span> {g.name}
            </a>
          </h3>
          {items.length ? (
            <ul class="result-list">
              {items.map((r) => (
                <li>
                  <a href={r.url} {...(r.external ? { rel: 'noopener' } : {})}>
                    <span class="code">{r.code}</span>
                    <span class="result-list__title" lang={r.lang}>{r.title}</span>
                    <span class="result-list__meta">
                      {kindLabel[r.kind]} · {statusLabel(r.status)}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="universe__empty">No public results yet.</p>
          )}
        </section>
      ))
    }
  </div>

  <p class="universe__note">One galaxy per field. Stars are decoration; positions and sizes are not rankings.</p>
</section>

<script>
  import { initUniverse } from '../scripts/universe';
  document.querySelectorAll<HTMLElement>('[data-universe]').forEach((el) => initUniverse(el));
</script>

<style is:global>
  .universe {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .universe__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
    padding-bottom: 14px;
  }

  .universe__bar h2 {
    font-size: 12px;
  }

  .universe__bar-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .universe__replay {
    padding: 0;
    border: 0;
    background: none;
    color: var(--dim);
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .universe__replay:hover,
  .universe__replay:focus-visible {
    color: var(--starlight);
  }

  .universe__open {
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .universe__map {
    position: relative;
    flex: 1;
    min-height: 0;
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius-md);
    background:
      linear-gradient(rgb(56 84 103 / 0.06) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(90deg, rgb(56 84 103 / 0.06) 1px, transparent 1px) 0 0 / 40px 40px,
      radial-gradient(ellipse at 50% 50%, rgb(14 22 34 / 0.92), rgb(4 7 12 / 0.96) 78%);
    overflow: hidden;
  }

  .universe__svg {
    display: block;
    width: 100%;
    height: 100%;
    user-select: none;
    -webkit-user-select: none;
  }

  /* ambient sky & instrument geometry: decoration only */
  .tw {
    animation: twinkle 7s ease-in-out infinite;
  }

  .tw2 { animation-duration: 10s; animation-delay: -4s; }
  .tw3 { animation-duration: 13s; animation-delay: -6s; }

  @keyframes twinkle {
    0%, 100% { opacity: 0.15; }
    50% { opacity: 0.8; }
  }

  .u-ring {
    fill: none;
    stroke: #385467;
    stroke-opacity: 0.32;
    vector-effect: non-scaling-stroke;
  }

  .u-ring--scale {
    stroke-dasharray: 2 6;
    stroke-opacity: 0.55;
  }

  .u-tick {
    stroke: #385467;
    stroke-opacity: 0.55;
    vector-effect: non-scaling-stroke;
  }

  .u-tick--long {
    stroke: #6f8ea0;
  }

  .u-instrument,
  .u-ambient {
    transition: opacity var(--t-open) var(--ease);
  }

  /* galaxies */
  .galaxy {
    cursor: pointer;
    outline: none;
  }

  .galaxy__hit {
    fill: transparent;
  }

  .galaxy__reticle {
    fill: none;
    stroke: #82d0dc;
    stroke-width: 1;
    stroke-dasharray: 3 7;
    opacity: 0;
    vector-effect: non-scaling-stroke;
    transition: opacity var(--t-identify) var(--ease), stroke var(--t-identify) var(--ease);
  }

  .galaxy-art {
    opacity: 0.82;
    transition: opacity var(--t-focus) var(--ease);
  }

  .galaxy:hover .galaxy-art,
  .galaxy:focus-visible .galaxy-art,
  .galaxy-wrap.is-selected .galaxy-art {
    opacity: 1;
  }

  /* the detailed chart exists only inside a galaxy (hidden also from keyboard and screen readers) */
  .galaxy__detail {
    visibility: hidden;
    opacity: 0;
    transition: opacity var(--t-open) var(--ease), visibility 0s linear var(--t-open);
  }

  .galaxy-wrap.is-selected .galaxy__detail {
    visibility: visible;
    opacity: 1;
    transition: opacity var(--t-open) var(--ease) 120ms, visibility 0s;
  }

  .galaxy-wrap.is-selected .galaxy {
    pointer-events: none;
  }

  .galaxy:hover .galaxy__reticle {
    opacity: 0.7;
  }

  .galaxy:focus-visible .galaxy__reticle {
    stroke: #e9c18f;
    stroke-width: 2;
    stroke-dasharray: none;
    opacity: 1;
  }

  .universe.is-zoomed .galaxy-wrap:not(.is-selected) {
    opacity: 0.12;
    pointer-events: none;
    transition: opacity var(--t-open) var(--ease);
  }

  .universe.is-zoomed .u-instrument {
    opacity: 0.25;
  }

  .universe.is-zoomed .galaxy-wrap.is-selected .galaxy__reticle {
    opacity: 0;
  }

  /* opening sequence (src/scripts/universe.ts): the sky lights up, then each galaxy forms from its core */
  .universe.is-intro-wait .universe__svg,
  .universe.is-intro-wait .universe__hint {
    opacity: 0;
  }

  .universe.is-intro .u-star {
    animation: fade-in 900ms ease-out both;
    animation-delay: calc(var(--k, 0) * 1200ms);
  }

  .universe.is-intro .u-ring {
    animation: fade-in 1400ms ease-out both;
    animation-delay: 250ms;
  }

  .universe.is-intro .u-tick {
    animation: fade-in 300ms ease-out both;
    animation-delay: calc(400ms + var(--k, 0) * 1000ms);
  }

  .universe.is-intro .universe__hint {
    animation: fade-in 700ms ease-out both;
    animation-delay: 3100ms;
  }

  /* after the opening, each galaxy's reticle blinks once: "these can be opened" */
  .universe.is-greet .galaxy__reticle {
    animation: reticle-greet 1300ms ease-in-out both;
    animation-delay: calc(var(--gi, 0) * 200ms);
  }

  @keyframes reticle-greet {
    0%, 100% { opacity: 0; }
    40% { opacity: 0.75; }
  }

  .universe__hint {
    position: absolute;
    left: 16px;
    bottom: 12px;
    margin: 0;
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
    pointer-events: none;
    transition: opacity var(--t-focus) var(--ease);
  }

  .universe.is-zoomed .universe__hint {
    opacity: 0;
  }

  /* the panel shown inside a galaxy */
  .universe__panels {
    position: absolute;
    top: 14px;
    right: 14px;
    bottom: 14px;
    width: min(330px, 46%);
    overflow: auto;
    border: 1px solid rgb(233 193 143 / 0.5);
    border-radius: var(--radius-md);
    background: rgb(11 29 48 / 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 24px 60px -30px rgb(0 0 0 / 0.8);
    animation: panel-in var(--t-open) var(--ease);
  }

  @keyframes panel-in {
    from { opacity: 0; transform: translateX(10px); }
  }

  .universe__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 20px 20px 18px;
  }

  .universe__panel:focus {
    outline: none;
  }

  .universe__panel h3 {
    margin: 10px 0 4px;
    padding-right: 28px;
    font-size: 24px;
    font-weight: 600;
  }

  .universe__zh {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }

  .universe__blurb {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
  }

  .universe__count {
    margin: 22px 0 8px;
    padding-top: 14px;
    border-top: 1px solid var(--hairline-soft);
    font-size: 11px;
  }

  .universe__close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 32px;
    height: 32px;
    border: 0;
    background: none;
    color: var(--muted);
    font-size: 22px;
    cursor: pointer;
  }

  .universe__close:hover {
    color: var(--starlight);
  }

  .universe__empty {
    margin: 0;
    color: var(--dim);
    font: 500 12.5px/1.6 var(--font-mono);
    letter-spacing: 0.06em;
  }

  .universe__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 20px;
  }

  .universe__actions .btn {
    flex: 1 1 auto;
  }

  /* list view */
  .universe__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 8px 36px;
  }

  .universe__group h3 {
    margin: 14px 0 8px;
    font-size: 17px;
  }

  .universe__group h3 a {
    color: var(--starlight);
    text-decoration: none;
  }

  .universe__note {
    margin: 10px 0 0;
    font: 500 11px/1.5 var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--dim);
  }

  @media (max-width: 767px) {
    .universe__map {
      flex: none;
      overflow: visible;
    }

    .universe__svg {
      height: auto;
      aspect-ratio: 1000 / 700;
    }

    .universe__panels {
      position: relative;
      inset: auto;
      width: auto;
      margin: 0 10px 10px;
      animation-name: panel-in-up;
    }

    @keyframes panel-in-up {
      from { opacity: 0; transform: translateY(8px); }
    }
  }
</style>

---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Backdrop, { type Sky } from '../components/Backdrop.astro';
import StarGlow from '../components/StarGlow.astro';
import { creditLine, spots } from '../data/pillars';
import { cvHref, profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  /** Where this page sits in the Pillars of Creation (see Backdrop.astro). */
  sky?: Sky;
  /** Only the pillars: no site header or footer (the home page and the four parts). */
  bare?: boolean;
}

const { title, description = [`${profile.name} — ${profile.role}.`, profile.subline].filter(Boolean).join(' ') } = Astro.props;
const fullTitle = title ? `${title} · ${profile.name}` : profile.name;
const initials = profile.name
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .toUpperCase();
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
// each section of the site floats over the part of the pillars it belongs to
const placeFor = (p: string): [number, number] =>
  p.startsWith('/research') || p.startsWith('/publications')
    ? spots.research
    : p.startsWith('/projects') || p.startsWith('/notes')
      ? spots.works
      : p.startsWith('/about')
        ? spots.intro
        : spots.contact;
const sky: Sky = Astro.props.sky ?? { mode: 'page', at: placeFor(path) };

const nav = [
  { href: '/research/', label: 'Research' },
  { href: '/publications/', label: 'Publications' },
  { href: '/projects/', label: 'Projects' },
  { href: '/notes/', label: 'Notes' },
  { href: '/about/', label: 'About' },
];
const current = (href: string) => (path.startsWith(href) ? 'page' : undefined);
// CV is always one click away: the PDF when it exists, otherwise the CV section of About.
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" class:list={[Astro.props.bare && 'bare']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#071320" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, over the Pillars of Creation`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        if (localStorage.getItem('oq.motion') === 'reduce') document.documentElement.dataset.motion = 'reduce';
      } catch {}
      document.documentElement.classList.add('js');
      // the living sky needs WebGL 2; without it pages keep a still image (?still forces that)
      try {
        if (!/[?&]still\b/.test(location.search) && document.createElement('canvas').getContext('webgl2')) document.documentElement.classList.add('has-gl');
      } catch {}
    </script>
  </head>
  <body>
    <Backdrop sky={sky} />
    <StarGlow />
    <slot name="intro" />
    <a class="skip-link" href="#main">Skip to content</a>

    {!Astro.props.bare && (
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/" aria-label={`${profile.name} — home`}>
          <span class="brand__mark">{initials}</span>
          <span class="brand__name">{profile.name}</span>
        </a>
        <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu>
          <span aria-hidden="true">≡</span><span class="visually-hidden">Menu</span>
        </button>
        <nav class="nav" id="site-nav" aria-label="Main">
          <ul>
            {nav.map((n) => <li><a href={n.href} aria-current={current(n.href)}>{n.label}</a></li>)}
            <li><a class="nav__cv" href={cvHref}>{profile.cv ? 'CV ↓' : 'CV'}</a></li>
          </ul>
        </nav>
      </div>
    </header>
    )}

    <main id="main">
      <slot />
    </main>

    {!Astro.props.bare && (
    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>© {year} {profile.name}</span>
        <span>Sky: {creditLine}.</span>
        <span>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          &nbsp;·&nbsp;
          <button type="button" data-motion-toggle aria-pressed="false">Reduce motion</button>
        </span>
      </div>
    </footer>
    )}

    <script>
      const menu = document.querySelector<HTMLButtonElement>('[data-menu]');
      const nav = document.getElementById('site-nav');
      menu?.addEventListener('click', () => {
        const open = menu.getAttribute('aria-expanded') !== 'true';
        menu.setAttribute('aria-expanded', String(open));
        nav?.setAttribute('data-open', String(open));
      });

      const toggle = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');
      const root = document.documentElement;
      const sync = () => toggle?.setAttribute('aria-pressed', String(root.dataset.motion === 'reduce'));
      sync();
      toggle?.addEventListener('click', () => {
        const reduce = root.dataset.motion !== 'reduce';
        if (reduce) root.dataset.motion = 'reduce';
        else delete root.dataset.motion;
        try {
          localStorage.setItem('oq.motion', reduce ? 'reduce' : 'full');
        } catch {}
        sync();
        window.dispatchEvent(new CustomEvent('oq:motion'));
      });
    </script>
  </body>
</html>

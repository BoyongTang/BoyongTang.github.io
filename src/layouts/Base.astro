---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import Backdrop, { type Sky } from '../components/Backdrop.astro';
import { creditLine, spots } from '../data/pillars';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  /** Where this page sits in the Pillars of Creation (see Backdrop.astro). */
  sky?: Sky;
  /** Only the pillars: no site header or footer (the home page and the four parts; only 404 has them). */
  bare?: boolean;
  /** A bare page that scrolls on past the pillars (the home page, to its second screen). */
  scrolls?: boolean;
}

const { title, description = [`${profile.name} — ${profile.role}.`, profile.subline].filter(Boolean).join(' ') } = Astro.props;
const fullTitle = title ? `${title} · ${profile.name}` : profile.name;
const initials = profile.name
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .toUpperCase();
const canonical = new URL(Astro.url.pathname, Astro.site);
// a page of text floats over the pillars' red tip, dimmed
const sky: Sky = Astro.props.sky ?? { mode: 'page', at: spots.intro };
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" class:list={[Astro.props.bare && 'bare', Astro.props.scrolls && 'scrolls']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#071320" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, over the Pillars of Creation`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        if (localStorage.getItem('oq.motion') === 'reduce') document.documentElement.dataset.motion = 'reduce';
      } catch {}
      document.documentElement.classList.add('js');
      // the living sky needs WebGL 2; without it pages keep a still image (?still forces that)
      try {
        if (!/[?&]still\b/.test(location.search) && document.createElement('canvas').getContext('webgl2')) document.documentElement.classList.add('has-gl');
      } catch {}
    </script>
  </head>
  <body>
    <Backdrop sky={sky} />
    <slot name="intro" />
    <a class="skip-link" href="#main">Skip to content</a>

    {!Astro.props.bare && (
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/" aria-label={`${profile.name} — home`}>
          <span class="brand__mark">{initials}</span>
          <span class="brand__name">{profile.name}</span>
        </a>
      </div>
    </header>
    )}

    <main id="main">
      <slot />
    </main>

    {!Astro.props.bare && (
    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>© {year} {profile.name}</span>
        <span>Sky: {creditLine}.</span>
        <span>
          {profile.email && (
            <>
              <a href={`mailto:${profile.email}`}>{profile.email}</a>
              &nbsp;·&nbsp;
            </>
          )}
          <button type="button" data-motion-toggle aria-pressed="false">Reduce motion</button>
        </span>
      </div>
    </footer>
    )}

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');
      const root = document.documentElement;
      const sync = () => toggle?.setAttribute('aria-pressed', String(root.dataset.motion === 'reduce'));
      sync();
      toggle?.addEventListener('click', () => {
        const reduce = root.dataset.motion !== 'reduce';
        if (reduce) root.dataset.motion = 'reduce';
        else delete root.dataset.motion;
        try {
          localStorage.setItem('oq.motion', reduce ? 'reduce' : 'full');
        } catch {}
        sync();
        window.dispatchEvent(new CustomEvent('oq:motion'));
      });
    </script>
  </body>
</html>

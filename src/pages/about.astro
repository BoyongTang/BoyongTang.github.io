---
import { profile } from '../data/profile';
import Base from '../layouts/Base.astro';
---

<Base title="About" description={`About ${profile.name} — ${profile.role}`}>
  <div class="wrap about-wrap">
    <header class="page-head">
      <p class="kicker">05 / Observer</p>
      <h1>About</h1>
      <p>
        Who I am, what I study, and how to reach me.
      </p>
    </header>

    <div class="section about-grid">
      <!-- ── Left: Profile narrative ── -->
      <div class="about-content">
        <section class="about-sec">
          <h2 class="eyebrow">Profile</h2>
          <p class="about-lead">
            {profile.name}
            {profile.altNames && profile.altNames.length > 0 && (
              <span class="about-alt">({profile.altNames.join(' · ')})</span>
            )}
          </p>
          <p class="about-role">{profile.role}</p>
          <p class="about-text">{profile.bio}</p>
          {profile.bioZh && <p class="about-text about-text--zh" lang="zh">{profile.bioZh}</p>}
        </section>

        <section class="about-sec">
          <h2 class="eyebrow">Education</h2>
          <ul class="edu-list">
            {profile.education.map((edu) => (
              <li class="edu-item">
                <span class="edu-when">{edu.when}</span>
                <div class="edu-details">
                  <h3 class="edu-what">{edu.what}</h3>
                  <p class="edu-where">{edu.where}</p>
                  {edu.note && <p class="edu-note">{edu.note}</p>}
                </div>
              </li>
            ))}
          </ul>
        </section>

        <section class="about-sec">
          <h2 class="eyebrow">Research interests</h2>
          <ul class="interests-tags">
            {profile.interests.map((interest) => (
              <li class="interest-chip">{interest}</li>
            ))}
          </ul>
          <p class="about-text about-text--small">
            Current work is in <a href="/research/">Research</a>; the relations between topics are in the
            <a href="/atlas/">atlas</a>.
          </p>
        </section>

        {profile.stack.length > 0 && (
          <section class="about-sec">
            <h2 class="eyebrow">Tools</h2>
            <ul class="interests-tags">
              {profile.stack.map((t) => <li class="interest-chip interest-chip--quiet">{t}</li>)}
            </ul>
          </section>
        )}
      </div>

      <!-- ── Right: Practical contact & documents ── -->
      <aside class="about-sidebar">
        <div class="dossier-box">
          <h2 class="eyebrow">Contact</h2>
          <ul class="contact-links">
            <li>
              <span class="contact-label">Email</span>
              <a href={`mailto:${profile.email}`} class="contact-val">{profile.email}</a>
            </li>
            <li>
              <span class="contact-label">Affiliation</span>
              <span class="contact-val">{profile.affiliation}</span>
            </li>
            <li>
              <span class="contact-label">Location</span>
              <span class="contact-val">{profile.location} ({profile.timezone})</span>
            </li>
            <li>
              <span class="contact-label">GitHub</span>
              <a href={profile.github} target="_blank" rel="noopener" class="contact-val">
                @{profile.handle} ↗
              </a>
            </li>
          </ul>

          <div class="cv-download" id="cv">
            <h3 class="eyebrow">Curriculum vitae</h3>
            {profile.cv ? (
              <a class="btn btn--primary" href={profile.cv} download>
                Download CV (PDF) ↓
              </a>
            ) : (
              <>
                <p class="cv-note">The PDF CV is in preparation. For a current copy, please write by email.</p>
                <a class="btn btn--primary" href={`mailto:${profile.email}?subject=CV%20request`}>Request CV by email</a>
              </>
            )}
          </div>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: clamp(32px, 5vw, 64px);
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .about-sec {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .about-lead {
    font-size: 28px;
    font-weight: 600;
    color: var(--starlight);
    margin: 0;
  }

  .about-alt {
    font-size: 18px;
    font-weight: 400;
    color: var(--dim);
    margin-left: 8px;
  }

  .about-role {
    font: 500 14px var(--font-mono);
    color: var(--signal-cyan);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0;
  }

  .about-text {
    color: var(--muted);
    font-size: 16.5px;
    line-height: 1.7;
    margin: 0;
  }

  .about-text--zh {
    font-size: 15px;
  }

  .edu-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .edu-item {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--hairline-soft);
  }

  .edu-when {
    font: 500 13px var(--font-mono);
    color: var(--selection-gold);
  }

  .edu-what {
    font-size: 17px;
    font-weight: 600;
    color: var(--starlight);
    margin: 0 0 4px;
  }

  .edu-where {
    font-size: 14.5px;
    color: var(--muted);
    margin: 0 0 4px;
  }

  .edu-note {
    font-size: 13px;
    color: var(--dim);
    margin: 0;
  }

  .interests-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .interest-chip--quiet {
    border-style: dashed;
    color: var(--muted);
  }

  .about-text--small {
    font-size: 14.5px;
  }

  .interest-chip {
    font: 500 13px var(--font-mono);
    padding: 6px 14px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    color: var(--starlight);
    background: rgb(11 29 48 / 0.6);
  }

  .dossier-box {
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius-md);
    background: rgb(11 29 48 / 0.6);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .contact-links {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contact-links li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .contact-label {
    font: 500 11px var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--dim);
  }

  .contact-val {
    color: var(--starlight);
    text-decoration: none;
    font-size: 14.5px;
  }

  .contact-val:hover {
    color: var(--signal-cyan);
  }

  .cv-download {
    scroll-margin-top: calc(var(--nav-h) + 24px);
    border-top: 1px solid var(--hairline-soft);
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cv-note {
    font-size: 13px;
    color: var(--dim);
    margin: 0;
    line-height: 1.5;
  }

  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import Atlas from '../components/Atlas.astro';
import Base from '../layouts/Base.astro';
import { loadGraph } from '../lib/graph';

const graph = await loadGraph();
---

<Base title="Research Atlas" description="An explorable map of research questions, methods, projects and notes, with a plain list view.">
  <div class="wrap atlas-page-wrap">
    <header class="page-head">
      <p class="kicker">Explore / Atlas</p>
      <h1>Research Atlas</h1>
      <p>
        Questions, methods, projects and notes, joined only by relations that are declared and explained. Select a
        point to see what it connects to, or switch to the list. Everything here is also reachable from the normal
        pages.
      </p>
    </header>

    <div class="atlas-full-container">
      <Atlas graph={graph} mode="full" heading="Research sky / Full atlas" />
    </div>
  </div>
</Base>

<style>
  .atlas-page-wrap {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - var(--nav-h));
    padding-bottom: 48px;
  }

  .atlas-full-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-top: 24px;
    min-height: min(760px, 90vh);
  }
</style>

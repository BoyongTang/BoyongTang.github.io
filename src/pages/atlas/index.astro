---
import Universe from '../../components/Universe.astro';
import Base from '../../layouts/Base.astro';
import { loadResults } from '../../lib/universe';

const results = await loadResults();
---

<Base title="Research Atlas" description="One galaxy per field. Enter a galaxy to see its results, or read everything as a list.">
  <div class="wrap atlas-page-wrap">
    <header class="page-head">
      <p class="kicker">Explore / Atlas</p>
      <h1>Research Atlas</h1>
      <p>
        Each galaxy is one field. Select a galaxy to look inside and see what has come out of it, or switch to the list.
        Everything here is also reachable from the normal pages.
      </p>
    </header>

    <div class="atlas-full-container">
      <Universe results={results} mode="full" heading="Research universe / Full atlas" />
    </div>
  </div>
</Base>

<style>
  .atlas-page-wrap {
    padding-bottom: 48px;
  }

  .atlas-full-container {
    display: flex;
    flex-direction: column;
    height: clamp(520px, calc(100vh - var(--nav-h) - 80px), 860px);
    margin-top: 24px;
  }

  .atlas-full-container :global(.universe) {
    flex: 1;
    min-height: 0;
  }

  @media (max-width: 767px) {
    .atlas-full-container {
      height: auto;
    }
  }
</style>

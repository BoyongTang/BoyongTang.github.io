---
import { getCollection } from 'astro:content';
import Atlas from '../components/Atlas.astro';
import { cvHref, profile } from '../data/profile';
import { VIEW } from '../data/atlas';
import Base from '../layouts/Base.astro';
import { loadGraph, statusLabel } from '../lib/graph';

const graph = await loadGraph();

// The three most recent real entries, newest first (dossiers before notes on the same day).
const research = (await getCollection('research')).map((e) => ({
  code: e.data.code, title: e.data.title, url: `/research/${e.id}/`, date: e.data.updatedAt, rank: 0,
  status: e.data.status, label: statusLabel(e.data.status),
}));
const notes = (await getCollection('notes')).map((e) => ({
  code: e.data.code, title: e.data.title, url: `/notes/${e.id}/`, date: e.data.date, rank: 1,
  status: 'note', label: 'NOTE',
}));
const signals = [...research, ...notes]
  .sort((a, b) => b.date.getTime() - a.date.getTime() || a.rank - b.rank || a.code.localeCompare(b.code))
  .slice(0, 3);

const byId = new Map(graph.nodes.map((n) => [n.id, n]));
---

<Base>
  <div class="home-viewport">
    <div class="wrap home-grid">
      <!-- ── Left: identity and direct access ── -->
      <section class="identity-pane" aria-labelledby="observer-heading">
        <div class="identity-pane__inner">
          <div class="identity-header">
            <p class="eyebrow">Observer / Profile 001</p>
            <h1 id="observer-heading" class="hero-name">
              {profile.name}
              {profile.altNames.length > 0 && <span class="hero-alt">{profile.altNames.join(' · ')}</span>}
            </h1>
            <p class="hero-role">{profile.role} · {profile.affiliation}</p>
            <p class="hero-tagline">{profile.tagline}</p>
            <p class="hero-bio">{profile.bio}</p>
            {profile.bioZh && <p class="hero-bio-zh" lang="zh">{profile.bioZh}</p>}
          </div>

          <div class="hero-actions">
            <a class="btn btn--primary" href="/research/">Explore Research</a>
            <a class="btn" href={cvHref}>{profile.cv ? 'View CV' : 'CV & Contact'}</a>
          </div>

          <div class="current-signals" aria-labelledby="signals-heading">
            <div class="current-signals__head">
              <h2 id="signals-heading" class="eyebrow">Current signals</h2>
              <span class="signals-count">{String(signals.length).padStart(2, '0')}</span>
            </div>
            <ul class="signals-list">
              {signals.map((s) => (
                <li class="signal-item">
                  <a href={s.url}>
                    <span class="code">{s.code}</span>
                    <span class="signal-item__title">{s.title}</span>
                    <span class={`status status--${s.status}`}>{s.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <footer class="identity-footer">
            <div class="identity-links">
              <a href={profile.github} rel="noopener">GitHub ↗</a>
              <a href={`mailto:${profile.email}`}>Email</a>
              <a href="/publications/">Publications</a>
              <a href="/notes/">Notes</a>
            </div>
            <p class="affiliation-badge">{profile.affiliation} · {profile.location} · {profile.timezone}</p>
          </footer>
        </div>
      </section>

      <!-- ── Right: the research sky (tablet and desktop) ── -->
      <section class="atlas-pane" aria-label="Research atlas">
        <Atlas graph={graph} mode="home" heading="Research sky / Live atlas" />
      </section>

      <!-- ── Phones: a static preview, the full atlas one tap away ── -->
      <section class="atlas-preview" aria-labelledby="preview-heading">
        <div class="atlas-preview__head">
          <h2 id="preview-heading" class="eyebrow">Atlas / Preview</h2>
          <span class="signals-count">{String(graph.nodes.length).padStart(2, '0')} signals</span>
        </div>
        <a class="atlas-preview__map" href="/atlas/" aria-label="Open the research atlas">
          <svg viewBox={`40 60 ${VIEW.w - 60} ${VIEW.h - 100}`} aria-hidden="true">
            {graph.edges.map((e) => {
              const a = byId.get(e.source)!;
              const b = byId.get(e.target)!;
              return <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} class="pv-edge" />;
            })}
            {graph.nodes.map((n) =>
              n.featured ? (
                <g>
                  <circle cx={n.x} cy={n.y} r="26" class="pv-orbit" />
                  <circle cx={n.x} cy={n.y} r="11" class="pv-core pv-core--featured" />
                </g>
              ) : (
                <circle cx={n.x} cy={n.y} r="8" class={`pv-core pv-core--${n.type}`} />
              ),
            )}
          </svg>
        </a>
        <div class="atlas-preview__actions">
          <a class="btn" href="/atlas/">Open atlas</a>
          <a class="btn btn--ghost" href="/research/">Research list →</a>
        </div>
      </section>
    </div>
  </div>
</Base>

<style>
  .home-viewport {
    padding: clamp(28px, 4vh, 48px) 0 clamp(32px, 5vh, 56px);
  }

  /* B1 §6.2: identity column 430–500px, the sky takes the rest */
  .home-grid {
    display: grid;
    grid-template-columns: minmax(380px, 460px) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: stretch;
  }

  .identity-pane {
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-right: 1px solid var(--hairline-soft);
    padding-right: clamp(20px, 3vw, 44px);
  }

  .identity-pane__inner {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .identity-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hero-name {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: clamp(40px, 4.4vw, 58px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .hero-alt {
    font: 500 13px/1.4 var(--font-mono);
    letter-spacing: 0.14em;
    color: var(--dim);
  }

  .hero-role {
    margin: 2px 0 0;
    font: 500 12.5px/1.6 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal-cyan);
  }

  .hero-tagline {
    position: relative;
    margin: 6px 0 0;
    padding-top: 16px;
    font: 500 22px/1.3 var(--font-display);
    color: var(--starlight);
  }

  .hero-tagline::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 88px;
    height: 1px;
    background: var(--selection-gold);
  }

  .hero-bio {
    margin: 0;
    max-width: 46ch;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.65;
  }

  .hero-bio-zh {
    margin: 0;
    max-width: 44ch;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .current-signals {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 20px;
    border-top: 1px solid var(--hairline-soft);
  }

  .current-signals__head,
  .atlas-preview__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .signals-count {
    font: 500 12px var(--font-mono);
    letter-spacing: 0.1em;
    color: var(--dim);
  }

  .signals-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .signal-item a {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 12px;
    padding: 9px 10px;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--starlight);
    text-decoration: none;
    transition: background-color var(--t-identify), border-color var(--t-identify);
  }

  .signal-item a:hover {
    background: rgb(130 208 220 / 0.08);
    border-color: var(--hairline-soft);
  }

  .signal-item__title {
    font-size: 14.5px;
    line-height: 1.4;
  }

  .signal-item a:hover .signal-item__title {
    color: var(--signal-cyan);
  }

  .identity-footer {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--hairline-soft);
  }

  .identity-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font: 500 12.5px/1.6 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .identity-links a {
    color: var(--muted);
    text-decoration: none;
  }

  .identity-links a:hover {
    color: var(--starlight);
  }

  .affiliation-badge {
    margin: 0;
    font: 400 12px/1.4 var(--font-mono);
    color: var(--dim);
  }

  .atlas-pane {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: clamp(560px, calc(100vh - var(--nav-h) - 96px), 820px);
  }

  .atlas-pane :global(.atlas) {
    flex: 1;
    min-height: 0;
  }

  .atlas-preview {
    display: none;
  }

  @media (max-width: 1199px) {
    .home-grid {
      grid-template-columns: 1fr;
    }

    .identity-pane {
      padding: 0 0 32px;
      border-right: 0;
      border-bottom: 1px solid var(--hairline-soft);
    }

    .atlas-pane {
      height: auto;
    }

    .atlas-pane :global(.atlas__map) {
      flex: none;
      aspect-ratio: 1000 / 700;
    }
  }

  /* B1 §11.1: phones get a static preview, never a squeezed desktop graph */
  @media (max-width: 767px) {
    .atlas-pane {
      display: none;
    }

    .atlas-preview {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .atlas-preview__map {
      display: block;
      border: 1px solid var(--hairline-soft);
      border-radius: var(--radius-md);
      background: radial-gradient(ellipse at 55% 50%, rgb(22 48 68 / 0.9), rgb(7 19 32 / 0.6) 75%);
    }

    .atlas-preview__map svg {
      width: 100%;
      height: auto;
    }

    .pv-edge {
      stroke: #8fc3b4;
      stroke-opacity: 0.45;
      stroke-width: 2;
    }

    .pv-core {
      fill: #ecf3f0;
    }

    .pv-core--question,
    .pv-core--method {
      fill: #0b1d30;
      stroke: #82d0dc;
      stroke-width: 3;
    }

    .pv-core--featured {
      fill: #e9c18f;
    }

    .pv-orbit {
      fill: none;
      stroke: #e9c18f;
      stroke-opacity: 0.5;
      stroke-width: 2;
    }

    .atlas-preview__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .hero-actions .btn {
      flex: 1 1 100%;
    }
  }
</style>

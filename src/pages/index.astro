---
// The home page: the whole site on one screen (src/components/Explorer.astro).
import Explorer from '../components/Explorer.astro';
import Base from '../layouts/Base.astro';
import { loadSky } from '../lib/sky';

const sky = await loadSky();
---

<Base sky={{ mode: 'explore' }} bare>
  <Explorer sky={sky} />
</Base>

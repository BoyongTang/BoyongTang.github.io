---
import Explorer from '../components/Explorer.astro';
import PartItems from '../components/PartItems.astro';
import { profile } from '../data/profile';
import Base from '../layouts/Base.astro';
import { loadSky } from '../lib/sky';

const sky = await loadSky();
---

<Base sky={{ mode: 'explore' }} bare>
  <Explorer sky={sky} />

  <section id="me" class="wrap me" aria-labelledby="me-heading">
    <div class="me__text">
      <h2 id="me-heading" class="eyebrow">About me</h2>
      {profile.bio && <p class="hero-bio">{profile.bio}</p>}
      {profile.bioZh && <p class="hero-bio-zh" lang="zh">{profile.bioZh}</p>}
      <div class="hero-actions">
        <a class="btn btn--primary" href="/sky/research/">Enter Research</a>
        {profile.cv && <a class="btn" href={profile.cv}>View CV</a>}
      </div>
    </div>

    <div class="me__side">
      <ul class="me__parts" aria-label="Four parts of me">
        {
          sky.map((f) => (
            <li>
              <a href={`/sky/${f.id}/`} style={`--c:${f.color}`}>
                <span class="me__dot" aria-hidden="true" />
                <span class="me__part">{f.name}</span>
                <span class="me__zh" lang="zh">{f.nameZh}</span>
                <span class="me__line">{f.line}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <footer class="identity-footer">
        <div class="identity-links">
          <a href={profile.github} rel="noopener">GitHub ↗</a>
          <a href={`mailto:${profile.email}`}>Scholar email</a>
          {profile.generalEmail && <a href={`mailto:${profile.generalEmail}`}>General email</a>}
        </div>
        <p class="affiliation-badge">{[profile.affiliation, profile.location].filter(Boolean).join(' · ')}</p>
      </footer>
    </div>
  </section>

  <section class="wrap parts-list" aria-labelledby="parts-heading">
    <h2 id="parts-heading" class="eyebrow">The four parts, as a list</h2>
    {
      sky.map((f) => (
        <div class="parts-list__part" style={`--c:${f.color}`}>
          <h3 class="parts-list__name">
            <a href={`/sky/${f.id}/`}>{f.name}</a> <span lang="zh">{f.nameZh}</span>
          </h3>
          <p class="parts-list__line">{f.line}</p>
          <PartItems f={f} />
        </div>
      ))
    }
  </section>
</Base>

<style>
  .me {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    padding-top: clamp(48px, 8vh, 88px);
    padding-bottom: clamp(48px, 8vh, 88px);
  }

  .me__text,
  .me__side {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .me__parts {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hairline-soft);
  }

  .me__parts a {
    display: grid;
    grid-template-columns: 14px 96px 40px minmax(0, 1fr);
    align-items: baseline;
    gap: 10px;
    padding: 11px 4px;
    border-bottom: 1px solid var(--hairline-soft);
    color: var(--starlight);
    text-decoration: none;
    transition: background-color var(--t-identify);
  }

  .me__parts a:hover {
    background: rgb(255 255 255 / 0.03);
  }

  .me__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 8px 1px var(--c);
    align-self: center;
  }

  .me__part {
    font: 500 12.5px/1.4 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .me__zh {
    font-size: 13px;
    color: var(--dim);
  }

  .me__line {
    font-size: 14.5px;
    color: var(--muted);
  }

  .hero-bio {
    margin: 0;
    max-width: 46ch;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.65;
  }

  .hero-bio-zh {
    margin: 0;
    max-width: 44ch;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .identity-footer {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--hairline-soft);
  }

  .identity-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font: 500 12.5px/1.6 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .identity-links a {
    color: var(--muted);
    text-decoration: none;
  }

  .identity-links a:hover {
    color: var(--starlight);
  }

  .affiliation-badge {
    margin: 0;
    font: 400 12px/1.4 var(--font-mono);
    color: var(--dim);
  }

  .parts-list {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding-bottom: clamp(48px, 8vh, 88px);
  }

  .parts-list__part {
    padding-top: 22px;
    border-top: 1px solid var(--hairline-soft);
  }

  .parts-list__name {
    margin: 0;
    font: 600 26px/1.2 var(--font-display);
  }

  .parts-list__name a {
    color: color-mix(in srgb, var(--c) 55%, #fff);
    text-decoration: none;
  }

  .parts-list__name span {
    font-weight: 400;
    font-size: 0.7em;
    color: var(--muted);
  }

  .parts-list__line {
    margin: 4px 0 0;
    color: var(--muted);
  }

  @media (max-width: 899px) {
    .me {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .hero-actions .btn {
      flex: 1 1 100%;
    }

    .me__parts a {
      grid-template-columns: 14px 1fr auto;
    }

    .me__line {
      grid-column: 2 / -1;
    }
  }
</style>

---
import Splash from '../components/Splash.astro';
import Universe from '../components/Universe.astro';
import { cvHref, profile } from '../data/profile';
import Base from '../layouts/Base.astro';
import { loadResults, statusLabel } from '../lib/universe';

const results = await loadResults();
// The three most recent dated results; the section disappears while there are none.
const signals = results.filter((r) => r.date).slice(0, 3);
---

<Base>
  <Splash slot="intro" />
  <div class="home-viewport">
    <div class="wrap home-grid">
      <!-- ── Left: identity and direct access ── -->
      <section class="identity-pane" aria-labelledby="observer-heading">
        <div class="identity-pane__inner">
          <div class="identity-header">
            <p class="eyebrow">Observer / Profile 001</p>
            <h1 id="observer-heading" class="hero-name">
              {profile.name}
              {profile.altNames.length > 0 && <span class="hero-alt">{profile.altNames.join(' · ')}</span>}
            </h1>
            <p class="hero-role">{profile.role} · {profile.affiliation}</p>
            <p class="hero-tagline">{profile.tagline}</p>
            <p class="hero-bio">{profile.bio}</p>
            {profile.bioZh && <p class="hero-bio-zh" lang="zh">{profile.bioZh}</p>}
          </div>

          <div class="hero-actions">
            <a class="btn btn--primary" href="/atlas/">Explore the atlas</a>
            <a class="btn" href={cvHref}>{profile.cv ? 'View CV' : 'CV & Contact'}</a>
          </div>

          {
            signals.length > 0 && (
              <div class="current-signals" aria-labelledby="signals-heading">
                <div class="current-signals__head">
                  <h2 id="signals-heading" class="eyebrow">Current signals</h2>
                  <span class="signals-count">{String(signals.length).padStart(2, '0')}</span>
                </div>
                <ul class="signals-list">
                  {signals.map((s) => (
                    <li class="signal-item">
                      <a href={s.url}>
                        <span class="code">{s.code}</span>
                        <span class="signal-item__title" lang={s.lang}>{s.title}</span>
                        <span class={`status status--${s.status}`}>{s.kind === 'note' ? 'NOTE' : statusLabel(s.status)}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <footer class="identity-footer">
            <div class="identity-links">
              <a href={profile.github} rel="noopener">GitHub ↗</a>
              <a href={`mailto:${profile.email}`}>Email</a>
              <a href="/research/">Research</a>
              <a href="/publications/">Publications</a>
            </div>
            <p class="affiliation-badge">{profile.affiliation} · {profile.location} · {profile.timezone}</p>
          </footer>
        </div>
      </section>

      <!-- ── Right: the research universe ── -->
      <section class="atlas-pane" aria-label="Research universe">
        <Universe results={results} mode="home" heading="Research universe" />
      </section>
    </div>
  </div>
</Base>

<style>
  .home-viewport {
    padding: clamp(28px, 4vh, 48px) 0 clamp(32px, 5vh, 56px);
  }

  /* B1 §6.2: identity column 430–500px, the sky takes the rest */
  .home-grid {
    display: grid;
    grid-template-columns: minmax(380px, 460px) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: stretch;
  }

  .identity-pane {
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-right: 1px solid var(--hairline-soft);
    padding-right: clamp(20px, 3vw, 44px);
  }

  .identity-pane__inner {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .identity-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hero-name {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: clamp(40px, 4.4vw, 58px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .hero-alt {
    font: 500 13px/1.4 var(--font-mono);
    letter-spacing: 0.14em;
    color: var(--dim);
  }

  .hero-role {
    margin: 2px 0 0;
    font: 500 12.5px/1.6 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal-cyan);
  }

  .hero-tagline {
    position: relative;
    margin: 6px 0 0;
    padding-top: 16px;
    font: 500 22px/1.3 var(--font-display);
    color: var(--starlight);
  }

  .hero-tagline::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 88px;
    height: 1px;
    background: var(--selection-gold);
  }

  .hero-bio {
    margin: 0;
    max-width: 46ch;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.65;
  }

  .hero-bio-zh {
    margin: 0;
    max-width: 44ch;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .current-signals {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 20px;
    border-top: 1px solid var(--hairline-soft);
  }

  .current-signals__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .signals-count {
    font: 500 12px var(--font-mono);
    letter-spacing: 0.1em;
    color: var(--dim);
  }

  .signals-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .signal-item a {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 12px;
    padding: 9px 10px;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--starlight);
    text-decoration: none;
    transition: background-color var(--t-identify), border-color var(--t-identify);
  }

  .signal-item a:hover {
    background: rgb(130 208 220 / 0.08);
    border-color: var(--hairline-soft);
  }

  .signal-item__title {
    font-size: 14.5px;
    line-height: 1.4;
  }

  .signal-item a:hover .signal-item__title {
    color: var(--signal-cyan);
  }

  .identity-footer {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--hairline-soft);
  }

  .identity-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font: 500 12.5px/1.6 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .identity-links a {
    color: var(--muted);
    text-decoration: none;
  }

  .identity-links a:hover {
    color: var(--starlight);
  }

  .affiliation-badge {
    margin: 0;
    font: 400 12px/1.4 var(--font-mono);
    color: var(--dim);
  }

  .atlas-pane {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: clamp(560px, calc(100vh - var(--nav-h) - 96px), 820px);
  }

  .atlas-pane :global(.universe) {
    flex: 1;
    min-height: 0;
  }

  @media (max-width: 1199px) {
    .home-grid {
      grid-template-columns: 1fr;
    }

    .identity-pane {
      padding: 0 0 32px;
      border-right: 0;
      border-bottom: 1px solid var(--hairline-soft);
    }

    .atlas-pane {
      height: auto;
    }

    .atlas-pane :global(.universe__map) {
      flex: none;
      aspect-ratio: 1000 / 700;
    }
  }

  @media (max-width: 767px) {
    .atlas-pane :global(.universe__map) {
      aspect-ratio: auto;
    }

    .hero-actions .btn {
      flex: 1 1 100%;
    }
  }
</style>

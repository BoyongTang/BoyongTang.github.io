---
import { galaxyById } from '../../data/galaxies';
import Base from '../../layouts/Base.astro';
import { publishedNotes } from '../../lib/universe';

const allNotes = (await publishedNotes()).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Base title="Notes" description="Field notes: working positions, checklists and derivations behind the research.">
  <div class="wrap">
    <header class="page-head">
      <h1>Notes</h1>
      <p>
        Working positions, checklists and derivations behind the research. Each note keeps its original language and
        ends with what is still open.
      </p>
    </header>

    <div class="section">
      {allNotes.length === 0 && (
        <div class="empty">
          <strong>No notes yet</strong>
          <p>Notes will appear here once they are written.</p>
        </div>
      )}
      <ul class="signals" hidden={allNotes.length === 0}>
        {allNotes.map((note) => (
          <li class="signal">
            <a href={`/notes/${note.id}/`}>
              <span class="code">{note.data.code}</span>
              <div>
                <span class="signal__title" lang={note.data.lang}>{note.data.title}</span>
                <p class="signal__summary" lang={note.data.lang}>{note.data.summary}</p>
              </div>
              <div class="signal__meta">
                <span>{galaxyById.get(note.data.topic)?.name}</span>
                <span>{note.data.lang === 'zh' ? '中文' : 'English'}</span>
                <time datetime={note.data.date.toISOString().slice(0, 10)}>
                  {note.data.date.toISOString().slice(0, 10)}
                </time>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Base>

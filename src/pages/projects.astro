---
import { projects } from '../data/profile';
import Base from '../layouts/Base.astro';
---

<Base title="Projects" description="Code and teaching work: what each project is for, its scope and its real status.">
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">03 / Instruments</p>
      <h1>Projects</h1>
      <p>
        Code and teaching work behind the research. A repository link appears only once the repository is public.
      </p>
    </header>

    <div class="section">
      <div class="projects-grid">
        {projects.map((proj) => (
          <article class="proj-card" id={proj.id}>
            <header class="proj-card__head">
              <span class="code">{proj.code}</span>
              <span class={`status status--${proj.status.toLowerCase()}`}>{proj.status.toUpperCase()}</span>
            </header>
            <h2 class="proj-card__title">{proj.name}</h2>
            {proj.nameZh && <p class="proj-card__tagline" lang="zh">{proj.nameZh}</p>}
            <p class="proj-card__desc">{proj.summary}</p>
            <ul class="proj-card__scope">
              {proj.scope.map((item) => <li>{item}</li>)}
            </ul>
            <div class="proj-card__tech">
              {proj.tech.map((t) => <span class="tech-tag">{t}</span>)}
            </div>
            <div class="proj-card__links">
              {proj.repo ? (
                <a class="btn" href={proj.repo} rel="noopener">Repository ↗</a>
              ) : (
                <span class="proj-card__pending">Repository not public yet</span>
              )}
              {proj.research && (
                <a class="btn btn--ghost" href={`/research/${proj.research}/`}>Research dossier →</a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</Base>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    gap: 24px;
  }

  .proj-card {
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius-md);
    background: rgb(11 29 48 / 0.5);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .proj-card__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .proj-card__title {
    font-size: 22px;
    font-weight: 600;
    color: var(--starlight);
    margin: 0;
  }

  .proj-card__tagline {
    color: var(--signal-cyan);
    font: 500 13.5px var(--font-mono);
    margin: 0;
  }

  .proj-card__desc {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .proj-card__tech {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tech-tag {
    font: 500 11.5px var(--font-mono);
    padding: 3px 8px;
    border-radius: 3px;
    background: rgb(56 84 103 / 0.35);
    color: var(--starlight);
  }

  .proj-card {
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }

  .proj-card:target {
    border-color: var(--selection-gold);
  }

  .proj-card__scope {
    margin: 0;
    padding-left: 1.1em;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.6;
  }

  .proj-card__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
  }

  .proj-card__pending {
    font: 500 12px var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }
</style>

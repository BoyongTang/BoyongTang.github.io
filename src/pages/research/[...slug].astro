---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { loadGraph, relationsOf, statusLabel } from '../../lib/graph';

export async function getStaticPaths() {
  const entries = await getCollection('research');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const graph = await loadGraph();

// Find the corresponding node in the graph
const thisNode = graph.nodes.find((n) => n.url === `/research/${entry.id}/`);
const related = thisNode ? relationsOf(graph, thisNode.id) : [];
---

<Base title={entry.data.title} description={entry.data.summary}>
  <div class="wrap dossier-container">
    <div class="dossier-layout">
      <!-- ── Left / Main: The Reading Surface ── -->
      <article class="dossier-main reading">
        <header class="dossier-header">
          <div class="dossier-meta">
            <span class="code">{entry.data.code}</span>
            <span class="dossier-meta__divider">/</span>
            <span class={`status status--${entry.data.status}`}>{statusLabel(entry.data.status)}</span>
            {entry.data.sample && <span class="sample-tag">SAMPLE</span>}
            <span class="dossier-meta__divider">/</span>
            <time datetime={entry.data.updatedAt.toISOString().slice(0, 10)}>
              {entry.data.updatedAt.toISOString().slice(0, 10)}
            </time>
          </div>
          <h1 class="dossier-title">{entry.data.title}</h1>
          <p class="dossier-lead">{entry.data.question}</p>
        </header>

        <div class="prose prose--numbered dossier-body">
          <Content />
        </div>

        {entry.data.links && entry.data.links.length > 0 && (
          <footer class="dossier-links">
            <h3 class="eyebrow">Public Artifacts &amp; Resources</h3>
            <div class="links-list">
              {entry.data.links.map((link) => (
                <a class="btn btn--primary" href={link.href} target="_blank" rel="noopener">
                  {link.label} ↗
                </a>
              ))}
            </div>
          </footer>
        )}
      </article>

      <!-- ── Right Column: Context & Relation Sky ── -->
      <aside class="dossier-sidebar" aria-label="Research Signal &amp; Relations">
        <div class="sidebar-block">
          <div class="sidebar-head">
            <p class="eyebrow">RESEARCH SIGNAL</p>
            <a class="sidebar-back" href="/research/">← All Research</a>
          </div>

          <div class="mini-sky">
            <svg viewBox="0 0 240 240" class="mini-sky__svg" aria-hidden="true">
              <!-- concentric instrument rings -->
              <circle cx="120" cy="120" r="105" class="mini-ring" />
              <circle cx="120" cy="120" r="75" class="mini-ring mini-ring--dash" />
              <circle cx="120" cy="120" r="45" class="mini-ring" />
              <line x1="15" y1="120" x2="225" y2="120" class="mini-axis" />
              <line x1="120" y1="15" x2="120" y2="225" class="mini-axis" />

              <!-- relations lines -->
              {related.map((rel, idx) => {
                const angle = (idx / related.length) * 2 * Math.PI - Math.PI / 2;
                const ox = 120 + 75 * Math.cos(angle);
                const oy = 120 + 75 * Math.sin(angle);
                return (
                  <g>
                    <line x1="120" y1="120" x2={ox} y2={oy} class="mini-rel-line" stroke-dasharray="3 3" />
                    <circle cx={ox} cy={oy} r="4" class="mini-node" />
                  </g>
                );
              })}

              <!-- central active node -->
              <circle cx="120" cy="120" r="12" class="mini-central-glow" />
              <circle cx="120" cy="120" r="6" class="mini-central-core" />
            </svg>
          </div>

          {related.length > 0 ? (
            <div class="sidebar-relations">
              <h3 class="eyebrow">RELATED SIGNALS / {String(related.length).padStart(2, '0')}</h3>
              <ul class="related-list">
                {related.map((r) => (
                  <li class="related-item">
                    <span class="related-edge-kind">{r.edge.relationLabel}</span>
                    <a href={r.other.url} class="related-link">
                      <span class="code">{r.other.code}</span>
                      <span class="related-name">{r.other.short}</span>
                    </a>
                    <span class="related-desc">{r.edge.description}</span>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <p class="sidebar-empty">No direct relation links declared.</p>
          )}

          <div class="sidebar-atlas-link">
            {thisNode ? (
              <a class="btn btn--ghost" href={`/atlas/#${thisNode.id}`}>
                View in Full Atlas ↗
              </a>
            ) : (
              <a class="btn btn--ghost" href="/atlas/">
                View in Full Atlas ↗
              </a>
            )}
          </div>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .dossier-container {
    padding: clamp(32px, 5vw, 64px) var(--gutter);
  }

  .dossier-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
  }

  .dossier-main {
    padding: clamp(32px, 6vw, 64px);
    border-radius: var(--radius-md);
  }

  .dossier-header {
    border-bottom: 1px solid var(--reading-rule);
    padding-bottom: 24px;
    margin-bottom: 32px;
  }

  .dossier-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 500 12.5px var(--font-mono);
    margin-bottom: 14px;
  }

  .dossier-meta__divider {
    color: var(--reading-muted);
  }

  .dossier-title {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 600;
    line-height: 1.15;
    color: var(--reading-ink);
    margin: 0 0 16px;
  }

  .dossier-lead {
    font-size: 19px;
    line-height: 1.6;
    color: var(--reading-muted);
    font-weight: 500;
    margin: 0;
  }

  .dossier-links {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--reading-rule);
  }

  .links-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
  }

  /* ── Sidebar ── */
  .dossier-sidebar {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
  }

  .sidebar-block {
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius-md);
    background: rgb(11 29 48 / 0.6);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .sidebar-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .sidebar-back {
    font: 500 12px var(--font-mono);
    text-decoration: none;
    color: var(--signal-cyan);
  }

  .mini-sky {
    background: rgb(7 19 32 / 0.85);
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius-sm);
    padding: 12px;
  }

  .mini-sky__svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .mini-ring {
    fill: none;
    stroke: var(--hairline);
    stroke-opacity: 0.5;
  }

  .mini-ring--dash {
    stroke-dasharray: 2 4;
  }

  .mini-axis {
    stroke: var(--hairline);
    stroke-opacity: 0.3;
  }

  .mini-rel-line {
    stroke: var(--signal-cyan);
    stroke-width: 1.2;
    stroke-opacity: 0.8;
  }

  .mini-node {
    fill: var(--orbit-green);
    stroke: var(--space-950);
    stroke-width: 1;
  }

  .mini-central-glow {
    fill: rgb(233 193 143 / 0.25);
  }

  .mini-central-core {
    fill: var(--selection-gold);
  }

  .sidebar-relations h3 {
    margin: 0 0 10px;
  }

  .related-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .related-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 13.5px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--hairline-soft);
  }

  .related-edge-kind {
    font: 500 11px var(--font-mono);
    text-transform: uppercase;
    color: var(--orbit-green);
    letter-spacing: 0.1em;
  }

  .related-link {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    color: var(--starlight);
    text-decoration: none;
    font-weight: 500;
  }

  .related-link:hover {
    color: var(--signal-cyan);
  }

  .related-desc {
    color: var(--dim);
    font-size: 12.5px;
    line-height: 1.4;
  }

  .sidebar-empty {
    color: var(--dim);
    font: 400 13px var(--font-mono);
    margin: 0;
  }

  .sidebar-atlas-link {
    border-top: 1px solid var(--hairline-soft);
    padding-top: 14px;
    text-align: center;
  }

  @media (max-width: 960px) {
    .dossier-layout {
      grid-template-columns: 1fr;
    }

    .dossier-sidebar {
      position: static;
      order: 2;
    }
  }
</style>

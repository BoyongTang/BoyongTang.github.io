---
import { render } from 'astro:content';
import GalaxyArt from '../../components/GalaxyArt.astro';
import { galaxyById, galaxyCode } from '../../data/galaxies';
import Base from '../../layouts/Base.astro';
import { loadResults, publishedResearch, resultsIn, statusLabel } from '../../lib/universe';

export async function getStaticPaths() {
  return (await publishedResearch()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const galaxy = galaxyById.get(entry.data.topic);
const url = `/research/${entry.id}/`;
const siblings = galaxy ? resultsIn(await loadResults(), galaxy.id).filter((r) => r.url !== url) : [];
const iso = (d: Date) => d.toISOString().slice(0, 10);
const pad = galaxy ? galaxy.r * 1.4 : 0;
---


<Base title={entry.data.title} description={entry.data.summary}>
  <div class="wrap dossier-container">
    <div class="dossier-layout">
      <!-- ── Left / Main: The Reading Surface ── -->
      <article class="dossier-main reading">
        <header class="dossier-header">
          <div class="dossier-meta">
            <span class="code">{entry.data.code}</span>
            <span class="dossier-meta__divider">/</span>
            <span class={`status status--${entry.data.status}`}>{statusLabel(entry.data.status)}</span>
                        <span class="dossier-meta__divider">/</span>
            <time datetime={iso(entry.data.updatedAt)}>Updated {iso(entry.data.updatedAt)}</time>
          </div>
          <h1 class="dossier-title">{entry.data.title}</h1>
          <p class="dossier-lead">{entry.data.question}</p>
        </header>

        <div class="prose prose--numbered dossier-body">
          <Content />
        </div>

        {entry.data.links && entry.data.links.length > 0 && (
          <footer class="dossier-links">
            <h2 class="eyebrow">Public artefacts</h2>
            <div class="links-list">
              {entry.data.links.map((link) => (
                <a class="btn btn--primary" href={link.href} target="_blank" rel="noopener">
                  {link.label} ↗
                </a>
              ))}
            </div>
          </footer>
        )}
      </article>

      <aside class="dossier-sidebar" aria-label="Field">
        <div class="sidebar-block">
          <div class="sidebar-head">
            <p class="eyebrow">Field {galaxy && `/ ${galaxyCode(galaxy)}`}</p>
            <a class="sidebar-back" href="/research/">← Back to research</a>
          </div>
          {galaxy && (
            <>
              <a class="mini-sky" href={`/atlas/${galaxy.id}/`} aria-label={`Open the ${galaxy.name} galaxy`}>
                <svg viewBox={`${galaxy.x - pad} ${galaxy.y - pad} ${pad * 2} ${pad * 2}`} class="mini-sky__svg" aria-hidden="true">
                  <GalaxyArt galaxy={galaxy} uid="dossier" />
                </svg>
              </a>
              <p class="sidebar-field">{galaxy.name}</p>
              {siblings.length > 0 && (
                <div class="sidebar-relations">
                  <h2 class="eyebrow">Also in this field / {String(siblings.length).padStart(2, '0')}</h2>
                  <ul class="result-list">
                    {siblings.map((r) => (
                      <li>
                        <a href={r.url}>
                          <span class="code">{r.code}</span>
                          <span class="result-list__title" lang={r.lang}>{r.title}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              <a class="btn btn--ghost" href={`/atlas/${galaxy.id}/`}>Open galaxy →</a>
            </>
          )}
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .dossier-container {
    padding: clamp(32px, 5vw, 64px) var(--gutter);
  }

  .dossier-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
  }

  .dossier-main {
    padding: clamp(32px, 6vw, 64px);
    border-radius: var(--radius-md);
  }

  .dossier-header {
    border-bottom: 1px solid var(--reading-rule);
    padding-bottom: 24px;
    margin-bottom: 32px;
  }

  .dossier-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 500 12.5px var(--font-mono);
    margin-bottom: 14px;
  }

  .dossier-meta__divider {
    color: var(--reading-muted);
  }

  .dossier-title {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 600;
    line-height: 1.15;
    color: var(--reading-ink);
    margin: 0 0 16px;
  }

  .dossier-lead {
    font-size: 19px;
    line-height: 1.6;
    color: var(--reading-muted);
    font-weight: 500;
    margin: 0;
  }

  .dossier-links {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--reading-rule);
  }

  .links-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
  }

  /* ── Sidebar ── */
  .dossier-sidebar {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
  }

  .sidebar-block {
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius-md);
    background: rgb(11 29 48 / 0.6);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .sidebar-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .sidebar-back {
    font: 500 12px var(--font-mono);
    text-decoration: none;
    color: var(--signal-cyan);
  }

  .mini-sky {
    display: block;
    background: rgb(7 19 32 / 0.85);
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius-sm);
    padding: 12px;
  }

  .mini-sky__svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .sidebar-field {
    margin: 0;
    font: 600 17px/1.3 var(--font-display);
  }

  .sidebar-relations h2 {
    margin: 0 0 10px;
  }

  @media (max-width: 960px) {
    .dossier-layout {
      grid-template-columns: 1fr;
    }

    .dossier-sidebar {
      position: static;
      order: 2;
    }
  }
</style>

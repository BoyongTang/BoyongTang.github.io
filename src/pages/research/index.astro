---
import Base from '../../layouts/Base.astro';
import { galaxyById } from '../../data/galaxies';
import { publishedResearch, statusLabel } from '../../lib/universe';

const research = (await publishedResearch()).sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime());
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Base title="Research" description="Research projects and their real status.">
  <div class="wrap">
    <header class="page-head">
      <h1>Research</h1>
      <p>
        What I am working on. Each status is the real stage of the work; results are linked only once they can be
        shared.
      </p>
      <div class="head-actions">
        <a class="btn" href="/sky/research/">See it as a star map</a>
      </div>
    </header>

    <section class="section" aria-label="Research projects">
      {research.length ? (
        <ul class="signals">
          {research.map((item) => (
            <li class="signal">
              <a href={`/research/${item.id}/`}>
                <span class="code">{item.data.code}</span>
                <div>
                  <span class="signal__title">{item.data.title}</span>
                  <p class="signal__summary">{item.data.summary}</p>
                </div>
                <div class="signal__meta">
                  <span class={`status status--${item.data.status}`}>{statusLabel(item.data.status)}</span>
                  <span>{galaxyById.get(item.data.topic)?.name}</span>
                  <time datetime={iso(item.data.updatedAt)}>Updated {iso(item.data.updatedAt)}</time>
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty">
          <strong>Nothing published yet</strong>
          <p>Research entries will appear here once their write-ups are ready.</p>
        </div>
      )}
    </section>
  </div>
</Base>

<style>
  .head-actions {
    margin-top: 24px;
  }
</style>

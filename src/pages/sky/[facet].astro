---
// One part of me, on its place in the Pillars of Creation: the explorer opens on it (drag, zoom, choose a
// star for its card), and below it the same stars are a plain list, which is also what keyboard,
// screen-reader and no-JavaScript visitors get.
import Explorer from '../../components/Explorer.astro';
import PartItems from '../../components/PartItems.astro';
import { PILLARS } from '../../data/pillars';
import Base from '../../layouts/Base.astro';
import { loadSky, type SkyFacet } from '../../lib/sky';

export async function getStaticPaths() {
  const sky = await loadSky();
  return sky.map((f) => ({ params: { facet: f.id }, props: { f, sky } }));
}

interface Props {
  f: SkyFacet;
  sky: SkyFacet[];
}

const { f, sky } = Astro.props;
const n = f.items.length;
const count = `${String(n).padStart(2, '0')} ${n === 1 ? 'star' : 'stars'}`;
---

<Base title={`${f.name} · ${f.nameZh}`} description={`${f.name} (${f.nameZh}): ${f.line} ${count} on Webb's Pillars of Creation.`} sky={{ mode: 'explore' }}>
  <Explorer sky={sky} focus={f.id} />

  <section id="list" class="wrap slist" aria-labelledby="slist-heading" style={`--c:${f.color}`}>
    <h2 id="slist-heading" class="eyebrow">Stars in {f.name} / {String(n).padStart(2, '0')}</h2>
    <PartItems f={f} />
    <p class="slist__note">
      Every star here is real: an interest, a tool, a place, a piece of work or a way to reach me. More appear as they happen. Lines join
      things that are actually related; positions mean nothing. Behind them: Webb's
      <a href={PILLARS.url} rel="noopener">{PILLARS.title}</a>, {PILLARS.credit}, {PILLARS.license}.
    </p>
  </section>

  <!-- the other parts' stars: the cards the map shows if you wander over to them -->
  <div hidden>
    {sky.filter((o) => o.id !== f.id).map((o) => <PartItems f={o} />)}
  </div>
</Base>

<style>
  .slist {
    padding-top: clamp(40px, 7vh, 72px);
    padding-bottom: clamp(48px, 8vh, 88px);
  }

  .slist__note {
    max-width: 70ch;
    margin: 26px 0 0;
    color: var(--dim);
    font-size: 14px;
  }
</style>

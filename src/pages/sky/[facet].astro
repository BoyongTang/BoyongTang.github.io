---
// One nebula's star map: full screen, drag to look around, scroll or pinch to zoom, select a star for
// its card. Every star is something real (src/lib/sky.ts). Below the map the same stars are a plain
// list, which is also what keyboard, screen-reader and no-JavaScript visitors get.
import Base from '../../layouts/Base.astro';
import { loadSky, WORLD, type SkyFacet } from '../../lib/sky';
import { seeded, starFill, starKind } from '../../lib/stars';

export async function getStaticPaths() {
  const sky = await loadSky();
  return sky.map((f, i) => ({
    params: { facet: f.id },
    props: { f, prev: sky[(i + sky.length - 1) % sky.length], next: sky[(i + 1) % sky.length] },
  }));
}

interface Props {
  f: SkyFacet;
  prev: SkyFacet;
  next: SkyFacet;
}

const { f, prev, next } = Astro.props;
const C = { x: WORLD.w / 2, y: WORLD.h / 2 };
const n = f.items.length;
const count = `${String(n).padStart(2, '0')} ${n === 1 ? 'star' : 'stars'}`;

// the nebula itself: soft clouds of its colour round the centre, with dark dust through them
const rand = seeded(f.seed * 131);
const gauss = () => Math.sqrt(-2 * Math.log(rand() || 1e-9)) * Math.cos(2 * Math.PI * rand());
const clouds = Array.from({ length: 9 }, (_, i) => ({
  x: C.x + gauss() * 330,
  y: C.y + gauss() * 220,
  rx: 260 + rand() * 420,
  ry: 160 + rand() * 260,
  rot: rand() * 180,
  fill: i % 3 === 2 ? 'deep' : 'main',
  o: 0.35 + rand() * 0.45,
}));
const dust = Array.from({ length: 5 }, () => ({
  x: C.x + gauss() * 300,
  y: C.y + gauss() * 200,
  rx: 120 + rand() * 260,
  ry: 40 + rand() * 90,
  rot: rand() * 180,
}));

// background stars: thin everywhere, thick inside the nebula
const field = [
  ...Array.from({ length: 900 }, () => ({ x: -300 + rand() * (WORLD.w + 600), y: -300 + rand() * (WORLD.h + 600), near: 0 })),
  ...Array.from({ length: 650 }, () => {
    const x = gauss() * 380;
    const y = gauss() * 260;
    return { x: C.x + x, y: C.y + y, near: Math.exp(-(x * x + y * y) / 250000) };
  }),
].map((p) => {
  const big = rand() ** 5;
  const glow = big > 0.45;
  const r = 0.7 + big * 2.6 + p.near * 0.6;
  return {
    x: +p.x.toFixed(1),
    y: +p.y.toFixed(1),
    r: +(glow ? r * 3.2 : r).toFixed(2),
    o: +Math.min(1, 0.18 + rand() * 0.45 + p.near * 0.3).toFixed(2),
    fill: starFill({ kind: starKind(rand()), glow }),
  };
});

const rings = [260, 520, 780, 1040];
const spokes = Array.from({ length: 24 }, (_, i) => (i * Math.PI) / 12);
---

<Base title={`${f.name} · ${f.nameZh}`} description={`${f.name} (${f.nameZh}): ${f.line} A star map of ${count}.`}>
  <section class="smap" style={`--c:${f.color};--d:${f.deep}`} aria-labelledby="smap-name" data-smap data-view={`${f.view.x} ${f.view.y} ${f.view.w} ${f.view.h}`} data-tall-view={`${f.tallView.x} ${f.tallView.y} ${f.tallView.w} ${f.tallView.h}`}>
    <svg
      class="smap__svg"
      viewBox={`${f.view.x} ${f.view.y} ${f.view.w} ${f.view.h}`}
      preserveAspectRatio="xMidYMid meet"
      role="group"
      aria-label={`${f.name} star map. ${count}; the same stars are listed below the map.`}
      data-svg
    >
      <defs>
        <radialGradient id="cl-main">
          <stop offset="0" stop-color={f.color} stop-opacity="0.2" />
          <stop offset="0.5" stop-color={f.color} stop-opacity="0.07" />
          <stop offset="1" stop-color={f.color} stop-opacity="0" />
        </radialGradient>
        <radialGradient id="cl-deep">
          <stop offset="0" stop-color={f.deep} stop-opacity="0.4" />
          <stop offset="1" stop-color={f.deep} stop-opacity="0" />
        </radialGradient>
        <radialGradient id="cl-dust">
          <stop offset="0" stop-color="#020407" stop-opacity="0.55" />
          <stop offset="1" stop-color="#020407" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="mg">
          <stop offset="0" stop-color="#ffffff" stop-opacity="0.95" />
          <stop offset="0.12" stop-color={f.color} stop-opacity="0.75" />
          <stop offset="0.35" stop-color={f.color} stop-opacity="0.2" />
          <stop offset="1" stop-color={f.color} stop-opacity="0" />
        </radialGradient>
      </defs>

      <rect x={-4000} y={-4000} width={WORLD.w + 8000} height={WORLD.h + 8000} fill="transparent" data-bg />

      <g class="smap__clouds" aria-hidden="true">
        {clouds.map((c) => <ellipse cx={c.x} cy={c.y} rx={c.rx} ry={c.ry} transform={`rotate(${c.rot} ${c.x} ${c.y})`} fill={`url(#cl-${c.fill})`} opacity={c.o} />)}
        {dust.map((c) => <ellipse cx={c.x} cy={c.y} rx={c.rx} ry={c.ry} transform={`rotate(${c.rot} ${c.x} ${c.y})`} fill="url(#cl-dust)" />)}
      </g>

      <g class="smap__grid" aria-hidden="true">
        {rings.map((r) => <circle cx={C.x} cy={C.y} r={r} />)}
        {spokes.map((a) => <line x1={C.x + Math.cos(a) * 130} y1={C.y + Math.sin(a) * 130} x2={C.x + Math.cos(a) * 1300} y2={C.y + Math.sin(a) * 1300} />)}
      </g>

      <g class="smap__field" aria-hidden="true" data-field data-x={C.x} data-y={C.y} data-r={900}>
        {field.map((s) => <circle cx={s.x} cy={s.y} r={s.r} opacity={s.o} fill={s.fill} />)}
      </g>

      <g class="smap__lines" aria-hidden="true">
        {f.lines.map(([a, b], i) => <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} pathLength="1" style={`--i:${i}`} data-a={a.id} data-b={b.id} />)}
      </g>

      <g class="smap__stars">
        {
          f.items.map((s, i) => {
            const big = s.mag === 1;
            const left = s.side === 'left';
            return (
              <a
                class:list={['mstar', big && 'mstar--bright']}
                href={`#i-${s.id}`}
                id={`s-${s.id}`}
                transform={`translate(${s.x} ${s.y})`}
                data-item={s.id}
                data-wide={`${s.x} ${s.y} ${s.side}`}
                data-tall={`${s.tall.x} ${s.tall.y} ${s.tall.side}`}
                style={`--i:${i};--n:${big ? 25 : 21};--np:${big ? 18 : 16}`}
                aria-label={`${s.kind}: ${s.name}${s.sub ? `, ${s.sub}` : ''}`}
              >
                <circle class="mstar__hit" r="44" />
                <circle class="mstar__glow" r={big ? 58 : 38} fill="url(#mg)" />
                <circle class="mstar__ring" r={big ? 18 : 14} />
                <circle class="mstar__core" r={big ? 4.6 : 3.4} />
                <g class="mstar__label">
                  <text class="mstar__name" dx={left ? '-1.3em' : '1.3em'} dy="-0.12em" text-anchor={left ? 'end' : 'start'} font-size={big ? 25 : 21} lang={s.lang}>
                    {s.name}
                  </text>
                  <text class="mstar__sub" dx={left ? '-2.1em' : '2.1em'} dy="1.61em" text-anchor={left ? 'end' : 'start'} font-size={big ? 15.5 : 13}>
                    {s.kind.toUpperCase()}
                    {s.sub ? ` · ${s.sub}` : ''}
                  </text>
                </g>
              </a>
            );
          })
        }
      </g>
    </svg>

    <div class="smap__hud smap__hud--top">
      <div class="smap__title">
        <a class="smap__back" href={`/#n-${f.id}`} data-back>← Star band</a>
        <p class="smap__code">{f.code} · Nebula</p>
        <h1 id="smap-name" class="smap__name">
          {f.name} <span lang="zh">{f.nameZh}</span>
        </h1>
        <p class="smap__line">{f.line} <span>{count}</span></p>
      </div>
      <div class="smap__tools" role="toolbar" aria-label="Map view">
        <button type="button" data-zoom="in" aria-label="Zoom in">+</button>
        <button type="button" data-zoom="out" aria-label="Zoom out">−</button>
        <button type="button" data-zoom="fit" aria-label="Show all stars">⤢</button>
        <a href="#list" class="smap__listbtn">List</a>
      </div>
    </div>

    <div class="smap__hud smap__hud--bottom">
      <p class="smap__hint" data-hint>Drag to look around · scroll or pinch to zoom · select a star</p>
      <nav class="smap__nav" aria-label="Other nebulae">
        <a href={`/sky/${prev.id}/`} style={`--c:${prev.color}`}>← {prev.name}</a>
        <a href={`/sky/${next.id}/`} style={`--c:${next.color}`}>{next.name} →</a>
      </nav>
    </div>

    <aside class="smap__card" aria-live="polite" data-card hidden>
      <button type="button" class="smap__close" data-close aria-label="Close">×</button>
      <div data-card-body></div>
    </aside>
  </section>

  <section id="list" class="wrap slist" aria-labelledby="slist-heading" style={`--c:${f.color}`}>
    <h2 id="slist-heading" class="eyebrow">Stars in {f.name} / {String(n).padStart(2, '0')}</h2>
    <ol class="slist__items">
      {
        f.items.map((s) => {
          const related = f.lines.filter(([a, b]) => a.id === s.id || b.id === s.id).map(([a, b]) => (a.id === s.id ? b : a));
          return (
            <li id={`i-${s.id}`} class="sitem">
              <article class="sitem__body" data-entry={s.id}>
                <p class="sitem__kind">
                  {s.kind}
                  {s.sub && <span> · {s.sub}</span>}
                </p>
                <h3 class="sitem__name" lang={s.lang}>
                  {s.name}
                  {s.nameZh && <span lang="zh"> {s.nameZh}</span>}
                </h3>
                {s.text && <p class="sitem__text">{s.text}</p>}
                {s.facts && (
                  <dl class="sitem__facts">
                    {s.facts.map((x) => (
                      <>
                        <dt>{x.label}</dt>
                        <dd>{x.value}</dd>
                      </>
                    ))}
                  </dl>
                )}
                {s.list && (
                  <ul class="sitem__list">
                    {s.list.map((x) => (
                      <li>{x}</li>
                    ))}
                  </ul>
                )}
                {s.tags && (
                  <ul class="sitem__tags" aria-label="Tools">
                    {s.tags.map((x) => (
                      <li>{x}</li>
                    ))}
                  </ul>
                )}
                {related.length > 0 && (
                  <p class="sitem__rel">
                    Linked to{' '}
                    {related.map((r, i) => (
                      <>
                        {i > 0 && ', '}
                        <a href={`#i-${r.id}`} data-goto={r.id}>
                          {r.name}
                        </a>
                      </>
                    ))}
                  </p>
                )}
                {s.links && s.links.length > 0 && (
                  <p class="sitem__links">
                    {s.links.map((l) => (
                      <a class="btn" href={l.href} rel={l.external ? 'noopener' : undefined}>
                        {l.label}
                        {l.external && !l.href.startsWith('mailto:') ? ' ↗' : ' →'}
                      </a>
                    ))}
                  </p>
                )}
              </article>
            </li>
          );
        })
      }
    </ol>
    <p class="slist__note">
      Every star here is real: an interest, a tool, a place, a piece of work or a way to reach me. More appear as they happen. Lines join
      things that are actually related; positions mean nothing.
    </p>
  </section>
</Base>

<script>
  import { initStarMap } from '../../scripts/starmap';

  const root = document.querySelector<HTMLElement>('[data-smap]');
  if (root) initStarMap(root);
</script>

<style>
  .smap {
    position: relative;
    height: calc(100svh - var(--nav-h));
    min-height: 480px;
    overflow: hidden;
    background:
      radial-gradient(ellipse 60% 55% at 50% 52%, color-mix(in srgb, var(--d) 18%, transparent), transparent 75%),
      #03060b;
    border-bottom: 1px solid var(--hairline-soft);
  }

  .smap__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    user-select: none;
    -webkit-user-select: none;
  }

  .smap.is-live .smap__svg {
    cursor: grab;
    touch-action: none;
  }

  .smap.is-dragging .smap__svg {
    cursor: grabbing;
  }

  .smap__grid circle,
  .smap__grid line {
    fill: none;
    stroke: #8fa6c8;
    stroke-opacity: 0.07;
    vector-effect: non-scaling-stroke;
  }

  .smap__grid circle:nth-child(2n) {
    stroke-dasharray: 2 7;
    stroke-opacity: 0.12;
  }

  .smap__lines line {
    stroke: var(--c);
    stroke-opacity: 0.45;
    stroke-width: 1.2px;
    vector-effect: non-scaling-stroke;
  }

  /* ── a real star ── */
  .mstar {
    cursor: pointer;
    outline: none;
  }

  .mstar__hit {
    fill: transparent;
  }

  .mstar__core {
    fill: #fff;
  }

  .mstar__ring {
    fill: none;
    stroke: var(--c);
    stroke-opacity: 0;
    vector-effect: non-scaling-stroke;
    transition: stroke-opacity var(--t-identify) var(--ease);
  }

  .mstar__name {
    font-family: var(--font-display);
    font-weight: 500;
    fill: #eef2f6;
    paint-order: stroke;
    stroke: #03060b;
    stroke-width: 0.3em;
    stroke-linejoin: round;
    transition: fill var(--t-identify) var(--ease);
  }

  /* with the script, labels keep a readable size as you zoom in (--ls: world units per screen pixel) */
  .smap.is-live .mstar__name {
    font-size: min(calc(var(--n) * 1.35px), calc(var(--np) * var(--ls, 1) * 1px));
  }

  .smap.is-live .mstar__sub {
    font-size: min(calc(var(--n) * 0.84px), calc(var(--np) * 0.62 * var(--ls, 1) * 1px));
  }

  .mstar__sub {
    font-family: var(--font-mono);
    letter-spacing: 0.14em;
    fill: color-mix(in srgb, var(--c) 70%, #8fa9b3);
    paint-order: stroke;
    stroke: #03060b;
    stroke-width: 0.3em;
    stroke-linejoin: round;
  }

  .mstar:hover .mstar__ring,
  .mstar.is-selected .mstar__ring {
    stroke-opacity: 0.8;
  }

  .mstar:hover .mstar__name,
  .mstar.is-selected .mstar__name {
    fill: color-mix(in srgb, var(--c) 45%, #fff);
  }

  .mstar:focus-visible .mstar__ring {
    stroke: var(--selection-gold);
    stroke-opacity: 1;
    stroke-width: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-motion='reduce'])) .mstar__glow {
      transform-box: fill-box;
      transform-origin: center;
      animation: mstar-breathe calc(6s + var(--i) * 0.7s) ease-in-out infinite;
    }
  }

  @keyframes mstar-breathe {
    0%, 100% { opacity: 0.85; }
    50% { opacity: 1; transform: scale(1.12); }
  }

  /* ── arriving: the field rushes out, the cloud gathers, lines draw, stars light one by one ── */
  .smap.is-arriving .smap__field circle {
    animation: star-burst 1400ms cubic-bezier(0.1, 0.8, 0.25, 1) both;
    animation-delay: calc(var(--k, 0) * 600ms);
  }

  .smap.is-arriving .smap__clouds {
    animation: fade-in 1800ms ease-out both;
  }

  .smap.is-arriving .smap__grid {
    animation: fade-in 1400ms ease-out 400ms both;
  }

  .smap.is-arriving .smap__lines line {
    stroke-dasharray: 1;
    animation: line-draw 900ms ease-out both;
    animation-delay: calc(1100ms + var(--i) * 140ms);
  }

  .smap.is-arriving .mstar {
    animation: fade-in 700ms ease-out both;
    animation-delay: calc(700ms + var(--i) * 110ms);
  }

  .smap.is-arriving .smap__hud {
    animation: fade-in 900ms ease-out 500ms both;
  }

  @keyframes line-draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }

  /* ── overlays ── */
  .smap__hud {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    pointer-events: none;
  }

  .smap__hud > * {
    pointer-events: auto;
  }

  .smap__hud--top {
    top: 22px;
    align-items: flex-start;
  }

  .smap__hud--bottom {
    bottom: 18px;
    align-items: flex-end;
  }

  .smap__title {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: min(440px, 60vw);
  }

  .smap__back,
  .smap__code,
  .smap__hint,
  .smap__nav a,
  .smap__listbtn {
    font: 500 11.5px/1.4 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .smap__back {
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 8px;
  }

  .smap__back:hover {
    color: var(--starlight);
  }

  .smap__code {
    margin: 0;
    color: color-mix(in srgb, var(--c) 70%, #8fa9b3);
  }

  .smap__name {
    margin: 0;
    font: 600 clamp(30px, 4vw, 48px) / 1.05 var(--font-display);
    letter-spacing: -0.02em;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.7);
  }

  .smap__name span {
    white-space: nowrap;
    font-weight: 400;
    font-size: 0.55em;
    color: var(--muted);
    letter-spacing: 0.05em;
  }

  .smap__line {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }

  .smap__line span {
    margin-left: 8px;
    font: 500 11.5px var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .smap__tools {
    display: flex;
    gap: 6px;
  }

  /* the zoom buttons and the drag hint only mean something once the script runs */
  .smap:not(.is-live) .smap__tools button,
  .smap:not(.is-live) .smap__hint {
    visibility: hidden;
  }

  .smap__tools button,
  .smap__listbtn {
    display: grid;
    place-items: center;
    min-width: 38px;
    height: 38px;
    padding: 0 10px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    background: rgb(3 6 11 / 0.6);
    color: var(--starlight);
    font: 500 17px/1 var(--font-mono);
    text-decoration: none;
    cursor: pointer;
  }

  .smap__listbtn {
    font-size: 11.5px;
  }

  .smap__tools button:hover,
  .smap__listbtn:hover {
    border-color: var(--c);
  }

  .smap__hint {
    margin: 0;
    color: var(--dim);
  }

  .smap__nav {
    display: flex;
    gap: 20px;
  }

  .smap__nav a {
    color: color-mix(in srgb, var(--c) 70%, #b9cfd6);
    text-decoration: none;
  }

  .smap__nav a:hover {
    color: var(--starlight);
  }

  /* ── a star's card ── */
  .smap__card {
    position: absolute;
    top: 96px;
    right: var(--gutter);
    width: min(380px, calc(100% - 2 * var(--gutter)));
    max-height: calc(100% - 170px);
    overflow: auto;
    padding: 22px 22px 20px;
    border: 1px solid color-mix(in srgb, var(--c) 35%, var(--hairline));
    border-radius: var(--radius-md);
    background: rgb(5 9 16 / 0.9);
    backdrop-filter: blur(6px);
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.5);
  }

  .smap__card[hidden] {
    display: none;
  }

  .smap__close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--muted);
    font-size: 22px;
    cursor: pointer;
  }

  .smap__close:hover {
    color: var(--starlight);
  }

  @media (max-width: 640px) {
    .smap__hint {
      display: none;
    }

    .smap__hud--bottom {
      justify-content: center;
    }

    .smap__card {
      top: auto;
      bottom: 0;
      right: 0;
      left: 0;
      width: auto;
      max-height: 60%;
      border-radius: var(--radius-md) var(--radius-md) 0 0;
    }

    .smap__hud--top {
      flex-direction: column-reverse;
      align-items: stretch;
      gap: 10px;
    }

    .smap__tools {
      justify-content: flex-end;
    }

    .smap__title {
      max-width: none;
      margin-top: -48px;
    }

    .smap__back {
      margin-bottom: 4px;
    }
  }

  /* ── the list (and the card's content) ── */
  .slist {
    padding-top: clamp(40px, 7vh, 72px);
    padding-bottom: clamp(48px, 8vh, 88px);
  }

  .slist__items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .sitem {
    padding: 18px 18px 16px;
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius-md);
    scroll-margin-top: calc(var(--nav-h) + 20px);
  }

  .sitem:target {
    border-color: var(--c);
  }

  .slist__note {
    max-width: 70ch;
    margin: 26px 0 0;
    color: var(--dim);
    font-size: 14px;
  }

  :global(.sitem__body) {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }


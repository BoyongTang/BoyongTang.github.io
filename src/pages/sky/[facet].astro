---
// One part of me, on its own address (/sky/<part>/): the same one screen as the home page, opened on it.
import Explorer from '../../components/Explorer.astro';
import Base from '../../layouts/Base.astro';
import { loadSky, type SkyFacet } from '../../lib/sky';

export async function getStaticPaths() {
  const sky = await loadSky();
  return sky.map((f) => ({ params: { facet: f.id }, props: { f, sky } }));
}

interface Props {
  f: SkyFacet;
  sky: SkyFacet[];
}

const { f, sky } = Astro.props;
---

<Base title={`${f.name} · ${f.nameZh}`} description={`${f.name} (${f.nameZh}): ${f.line}`} sky={{ mode: 'explore' }} bare>
  <Explorer sky={sky} focus={f.id} />
</Base>
